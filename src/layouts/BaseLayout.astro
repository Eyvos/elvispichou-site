---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { useI18n, switchLocalePath, locales, localeMeta } from '../i18n';
import loaderCss from '../styles/loader.css?raw';

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD supplémentaire propre à la page */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Publie les liens hreflang vers l'autre langue (désactivé pour la page 404). */
  alternates?: boolean;
}

const { lang, t } = useI18n(Astro.url);
const { title, description = t.site.description, jsonLd, noindex = false, alternates = true } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${t.site.role}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Même page dans chaque langue : hreflang pour les moteurs de recherche (x-default = français).
const alternateLinks = locales.map((l) => ({ hreflang: localeMeta[l].hreflang, href: new URL(switchLocalePath(Astro.url.pathname, l), site.url).href }));
const otherLocales = locales.filter((l) => l !== lang);

// Qui je suis et ce que je vends, pour les moteurs de recherche.
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      jobTitle: t.site.role,
      url: site.url,
      sameAs: Object.values(site.links).filter((l) => l?.startsWith('http')),
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#service`,
      name: `${site.name} · ${t.site.role}`,
      url: site.url,
      description: t.site.description,
      founder: { '@id': `${site.url}/#person` },
      areaServed: { '@type': 'Country', name: t.site.areaServed },
      knowsLanguage: ['fr', 'en'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.site.offerCatalog,
        itemListElement: t.site.services.map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
      },
    },
  ],
};

const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC ?? 'https://cloud.umami.is/script.js';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && alternateLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternateLinks[0].href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f1016" />
    <!-- Thème posé avant le premier rendu pour éviter tout flash : sombre par défaut, choix mémorisé ensuite. -->
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark'; }
      catch { document.documentElement.dataset.theme = 'dark'; }
    </script>

    <!-- Styles de l'écran de chargement en ligne : le dé et les textes n'attendent ni la feuille de style ni le fond. -->
    <style is:inline set:html={loaderCss} />
    <!-- Écran de chargement : le fond couvre la page dès le premier rendu (aucun contenu visible avant lui) ; le dé et les textes
         n'apparaissent que si la page n'est pas prête au bout de 0,45 s. Pose aussi `.js` pour les apparitions. -->
    <script is:inline>
      (function () {
        var d = document, h = d.documentElement, shown = false, tick;
        h.classList.add('js', 'loading');
        setTimeout(function () { if (!window.__reveal) h.classList.remove('js'); }, 6000);
        var timer = setTimeout(function () {
          if (d.readyState === 'complete') return;
          shown = true;
          h.classList.add('loader-show');
          tick = setInterval(function () {
            var n = d.querySelector('[data-loader-num]');
            if (n) n.textContent = String(1 + Math.floor(Math.random() * 19));
          }, 110);
        }, 450);
        function finish() {
          clearTimeout(timer);
          if (!shown) { h.classList.remove('loading'); return; }
          shown = false;
          clearInterval(tick);
          var n = d.querySelector('[data-loader-num]');
          if (n) n.textContent = '20';
          h.classList.add('loader-done');
          setTimeout(function () { h.classList.remove('loading', 'loader-show', 'loader-done'); }, 1000);
        }
        addEventListener('load', finish);
        setTimeout(finish, 15000);
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMeta[lang].og} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={localeMeta[l].og} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {umamiId && <script defer src={umamiSrc} data-website-id={umamiId} is:inline />}
  </head>
  <body class="min-h-dvh flex flex-col">
    <div class="loader" aria-hidden="true" data-loader>
      <div class="loader-panel">
        <p class="loader-brand">Elvis Pichou<span>.</span></p>
        <p class="loader-tagline">{t.loader.tagline}</p>
        <div class="loader-stage" aria-hidden="true">
          <div class="loader-bounce">
            <svg class="loader-die" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
              <polygon points="60,6 106,33 106,87 60,114 14,87 14,33" />
              <polygon points="60,30 92,82 28,82" />
              <path d="M60 30V6M60 30L14 33M60 30L106 33M92 82L106 33M92 82L106 87M92 82L60 114M28 82L14 33M28 82L14 87M28 82L60 114" stroke-width="1.8" />
              <text class="num" x="60" y="62" stroke="none" data-loader-num>20</text>
            </svg>
          </div>
          <div class="loader-shadow"></div>
        </div>
        <p class="loader-rule"><span>{t.loader.rule}</span></p>
        <span class="loader-bar" aria-hidden="true"></span>
      </div>
    </div>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn btn-primary">
      {t.common.skipToContent}
    </a>
    <Header />
    <main id="contenu" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <!-- Apparitions au défilement : cibles auto-détectées dans chaque section, plus tout élément déjà marqué data-reveal. -->
    <script is:inline>
      (function () {
        var d = document, h = d.documentElement;
        if (!h.classList.contains('js')) return;
        function mark(el, kind, delay) {
          if (el.hasAttribute('data-reveal')) return;
          el.setAttribute('data-reveal', kind);
          el.style.setProperty('--rd', delay + 'ms');
        }
        d.querySelectorAll('main section:not(#accueil)').forEach(function (sec) {
          var box = sec.querySelector(':scope > .container-page') || sec.firstElementChild || sec;
          Array.prototype.forEach.call(box.children, function (c, i) {
            if (c.matches('ul, ol, dl')) {
              Array.prototype.forEach.call(c.children, function (k, j) { mark(k, 'up', Math.min(j, 6) * 90); });
            } else {
              mark(c, c.matches('h1, h2') ? 'title' : 'up', Math.min(i, 3) * 70);
            }
          });
        });
        d.querySelectorAll('main > :not(section) .container-page > *, footer .container-page > *').forEach(function (c, i) {
          mark(c, 'up', Math.min(i, 4) * 80);
        });
        d.querySelectorAll('[data-reveal-delay]').forEach(function (el) {
          el.style.setProperty('--rd', el.getAttribute('data-reveal-delay') + 'ms');
        });
        var items = d.querySelectorAll('[data-reveal]');
        window.__reveal = true;
        function run() {
          if (!('IntersectionObserver' in window)) { items.forEach(function (el) { el.classList.add('is-in'); }); return; }
          function watch(entries, io) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              var el = e.target;
              io.unobserve(el);
              el.classList.add('is-in');
              // Fin d'animation : on retire l'attribut pour que le survol (transform) reprenne ses propres transitions.
              var wait = 1100 + (parseFloat(el.style.getPropertyValue('--rd')) || 0);
              setTimeout(function () { el.removeAttribute('data-reveal'); el.classList.remove('is-in'); el.style.removeProperty('--rd'); }, wait);
            });
          }
          // Le pied de page est collé au bas du document : sans marge négative, sa dernière ligne apparaît sans devoir défiler plus loin.
          var io = new IntersectionObserver(function (e) { watch(e, io); }, { rootMargin: '0px 0px -8% 0px', threshold: 0 });
          var ioFoot = new IntersectionObserver(function (e) { watch(e, ioFoot); }, { threshold: 0 });
          items.forEach(function (el) { (el.closest('footer') ? ioFoot : io).observe(el); });
        }
        // Derrière l'écran de chargement, on attend qu'il se retire pour que les apparitions soient vues.
        if (h.classList.contains('loading')) {
          var mo = new MutationObserver(function () { if (!h.classList.contains('loading')) { mo.disconnect(); run(); } });
          mo.observe(h, { attributes: true, attributeFilter: ['class'] });
        } else run();
      })();
    </script>
  </body>
</html>
