---
import { Menu, X, ArrowRight, Languages, Check } from '@lucide/astro';
import { site, nav, navProfile } from '../config/site';
import { useI18n, localePath, stripLocale, switchLocalePath, fmt, locales, localeMeta } from '../i18n';

const { lang, t } = useI18n(Astro.url);
const h = t.header;
const onProfile = stripLocale(Astro.url.pathname).replace(/\/$/, '') === navProfile.href;
// Une entrée par langue (la langue courante est marquée) : même page, autre langue.
const langOptions = locales.map((l) => ({ code: l, ...localeMeta[l], href: switchLocalePath(Astro.url.pathname, l), current: l === lang }));
const home = localePath(lang, '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur transition-shadow data-[scrolled]:shadow-[0_8px_24px_-16px_rgb(0_0_0/0.6)]" data-header>
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <!-- Marque -->
    <a href={home} class="flex h-10 shrink-0 items-center gap-2 font-display text-[15px] font-semibold tracking-tight min-[380px]:text-base" aria-label={fmt(h.brandLabel, { name: site.name })}>
      <span>Elvis Pichou<span class="text-accent-fg">.</span></span>
    </a>

    <!-- Menu principal (≥ 1024 px) : entrées à plat, section visible soulignée (D-28) -->
    <nav aria-label={h.navMain} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a href={localePath(lang, item.href)} data-nav-link class="nav-link">
              {h.nav[item.key]}
            </a>
          </li>
        ))}
        <li aria-hidden="true" class="mx-2 h-4 w-px bg-line-strong"></li>
        <li>
          <a
            href={localePath(lang, navProfile.href)}
            aria-current={onProfile ? 'page' : undefined}
            class="nav-link"
            data-umami-event="profil-nav"
          >
            {t.common.technicalProfile}
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-1 min-[380px]:gap-2 sm:gap-3">
      <!-- Thème et langue : deux boutons-icônes collés l'un à l'autre -->
      <div class="flex items-center">
      <button
        type="button"
        data-theme-toggle
        class="grid size-10 place-items-center rounded-full text-ink transition duration-300 hover:-rotate-12 hover:scale-105 hover:bg-surface active:scale-95"
        aria-label={h.themeToLight}
        data-label-to-light={h.themeToLight}
        data-label-to-dark={h.themeToDark}
      >
        <svg data-icon-sun class="hidden size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg data-icon-moon class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <!-- Sélecteur de langue : bouton rond (icône de traduction 文A) qui ouvre la liste des langues -->
      <div class="relative" data-lang-menu>
        <button
          type="button"
          data-lang-toggle
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-list"
          aria-label={h.languageMenu}
          title={h.languageMenu}
          class="lang-btn grid size-10 place-items-center rounded-full text-ink transition duration-300 hover:bg-surface aria-expanded:bg-surface"
          data-umami-event="lang-menu"
        >
          <Languages class="lang-icon size-5" aria-hidden="true" />
        </button>
        <ul id="lang-list" hidden class="absolute right-0 top-full z-50 mt-2 w-44 rounded-2xl border border-line-strong bg-bg p-1.5 shadow-[0_16px_32px_-16px_rgb(0_0_0/0.6)]">
          {langOptions.map((o) => (
            <li>
              <a
                href={o.href}
                lang={o.code}
                hreflang={o.code}
                data-lang-switch
                aria-current={o.current ? 'true' : undefined}
                class="flex items-center justify-between gap-3 rounded-xl px-3.5 py-2.5 text-sm font-semibold transition hover:bg-surface aria-[current=true]:text-accent-fg"
                data-umami-event="lang-switch"
                data-umami-event-lang={o.code}
              >
                <span>{o.label}</span>
                {o.current && <Check class="size-4" aria-hidden="true" />}
              </a>
            </li>
          ))}
        </ul>
      </div>
      </div>

      <!-- Sous 360 px, la place manque : l'action reste dans le menu burger (D-119). -->
      <a href={localePath(lang, '/#contact')} class="btn btn-primary !px-4 !py-2.5 max-[359px]:hidden" data-umami-event="cta-header">
        <span class="xl:hidden">{h.ctaShort}</span><span class="hidden xl:inline">{h.ctaLong}</span>
      </a>

      <button
        type="button"
        data-menu-toggle
        class="grid size-10 place-items-center rounded-full border border-line-strong text-ink transition duration-300 hover:scale-105 hover:border-ink active:scale-95 lg:hidden"
        aria-label={h.menuOpen}
        data-label-open={h.menuOpen}
        data-label-close={h.menuClose}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu data-icon-open class="size-5" aria-hidden="true" />
        <X data-icon-close class="hidden size-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Menu mobile (< 1024 px) : panneau plein écran sous l'en-tête, mêmes entrées que le menu principal -->
  <div id="mobile-menu" hidden class="absolute inset-x-0 top-full h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-line bg-bg lg:hidden">
    <nav aria-label={h.navMobile} class="container-page flex min-h-full flex-col py-6">
      <ul class="divide-y divide-line">
        {nav.map((item) => (
          <li>
            <a href={localePath(lang, item.href)} data-nav-link data-mobile-link class="group flex items-center gap-4 py-4 font-heading text-xl font-semibold aria-[current=true]:text-accent-fg">
              <span class="flex-1">{h.nav[item.key]}</span>
              <ArrowRight class="size-5 text-muted" aria-hidden="true" />
            </a>
          </li>
        ))}
        <li>
          <a
            href={localePath(lang, navProfile.href)}
            data-mobile-link
            aria-current={onProfile ? 'page' : undefined}
            class="flex items-center gap-4 py-4 text-base font-semibold text-muted aria-[current=page]:text-ink"
          >
            <span class="flex-1">{t.common.technicalProfile}</span>
            <ArrowRight class="size-5" aria-hidden="true" />
          </a>
        </li>
      </ul>

      <div class="mt-auto flex flex-col gap-4 pt-8">
        <a href={localePath(lang, '/#contact')} data-mobile-link class="btn btn-primary w-full" data-umami-event="cta-header-mobile">{h.ctaLong}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Entrée de menu à plat : texte atténué, section visible = texte plein + trait d'accent dessous. */
  .nav-link {
    position: relative;
    display: block;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
    transition: color 0.15s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.875rem;
    bottom: 0.125rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent-fg);
    transform: scaleX(0);
    transition: transform 0.2s ease-out;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  @media (hover: hover) {
    .nav-link:hover::after {
      transform: scaleX(0.4);
    }
  }
  .nav-link[aria-current='true'],
  .nav-link[aria-current='page'] {
    color: var(--color-ink);
  }
  .nav-link[aria-current='true']::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  /* Icône de langue : petit balancement au survol. */
  @media (hover: hover) {
    .lang-btn:hover .lang-icon {
      animation: lang-wiggle 0.6s ease-in-out;
    }
  }
  @keyframes lang-wiggle {
    0% { transform: rotate(0) scale(1); }
    25% { transform: rotate(-14deg) scale(1.15); }
    55% { transform: rotate(10deg) scale(1.15); }
    80% { transform: rotate(-4deg) scale(1.05); }
    100% { transform: rotate(0) scale(1); }
  }
  /* Liste des langues : apparition douce depuis le bouton (pas de saut). */
  #lang-list:not([hidden]) {
    transform-origin: top right;
    animation: lang-in 0.16s ease-out;
  }
  @keyframes lang-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
    #lang-list:not([hidden]),
    .lang-btn:hover .lang-icon {
      animation: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // ── Ombre sous l'en-tête dès que la page défile ──
  const syncScrolled = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', syncScrolled, { passive: true });
  syncScrolled();

  // ── Thème ──
  const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const sun = toggle.querySelector<SVGElement>('[data-icon-sun]')!;
  const moon = toggle.querySelector<SVGElement>('[data-icon-moon]')!;
  function syncTheme() {
    const light = root.dataset.theme === 'light';
    sun.classList.toggle('hidden', light);
    moon.classList.toggle('hidden', !light);
    toggle.setAttribute('aria-label', (light ? toggle.dataset.labelToDark : toggle.dataset.labelToLight) ?? '');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#f3f0e8' : '#0f1016');
  }
  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    // Le changement de palette est instantané partout : sans cela, les éléments qui animent leurs couleurs (boutons, cartes) clignotent.
    root.classList.add('theme-switching');
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    syncTheme();
    void root.offsetWidth;
    setTimeout(() => root.classList.remove('theme-switching'), 80);
  });
  syncTheme();

  // ── Menu mobile : défilement de la page verrouillé, focus gardé dans l'en-tête, fermeture par Échap / lien / clic hors panneau ──
  const burger = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = burger.querySelector('[data-icon-open]')!;
  const iconClose = burger.querySelector('[data-icon-close]')!;
  const isOpen = () => !menu.hidden;

  function setMenu(open: boolean, returnFocus = false) {
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', (open ? burger.dataset.labelClose : burger.dataset.labelOpen) ?? '');
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    root.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
    else if (returnFocus) burger.focus();
  }

  burger.addEventListener('click', () => setMenu(!isOpen()));
  menu.querySelectorAll('[data-mobile-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  menu.addEventListener('click', (e) => { if (e.target === menu) setMenu(false, true); });
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') return setMenu(false, true);
    if (e.key !== 'Tab') return;
    const items = [burger, ...menu.querySelectorAll<HTMLElement>('a')];
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // ── Section active : l'entrée correspondant à la section visible est marquée (page d'accueil uniquement) ──
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const hashOf = (a: HTMLAnchorElement) => new URL(a.href, location.href).hash.slice(1);
  const targets = links
    .map((a) => document.getElementById(hashOf(a)))
    .filter((el): el is HTMLElement => !!el);

  // ── Sélecteur de langue : liste ouverte au clic, fermée par Échap, clic ailleurs ou choix ──
  const langMenu = document.querySelector<HTMLElement>('[data-lang-menu]');
  if (langMenu) {
    const langBtn = langMenu.querySelector<HTMLButtonElement>('[data-lang-toggle]')!;
    const langList = langMenu.querySelector<HTMLElement>('#lang-list')!;
    const setLang = (open: boolean, returnFocus = false) => {
      langList.hidden = !open;
      langBtn.setAttribute('aria-expanded', String(open));
      if (!open && returnFocus) langBtn.focus();
    };
    // Au clavier (détail 0), le focus va sur la langue courante ; à la souris, rien ne bouge.
    langBtn.addEventListener('click', (e) => {
      const open = langList.hidden !== false;
      setLang(open);
      if (open && e.detail === 0) langList.querySelector<HTMLElement>('a[aria-current]')?.focus();
    });
    document.addEventListener('click', (e) => { if (!langList.hidden && !langMenu.contains(e.target as Node)) setLang(false); });
    langMenu.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !langList.hidden) setLang(false, true); });
    langList.addEventListener('focusout', (e) => { if (!langMenu.contains(e.relatedTarget as Node | null)) setLang(false); });
  }

  // ── Changement de langue : on reste exactement au même endroit de la page ──
  // On mémorise la section sous l'en-tête et le décalage dans cette section (ou, sans section, la proportion défilée) ; la page de l'autre langue les relit. Aucune ancre dans l'URL.
  const SCROLL_KEY = 'lang-scroll';
  const sections = () => [...document.querySelectorAll<HTMLElement>('main section[id]')];
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    const base = a.getAttribute('href')!;
    a.href = base + location.search;
    a.addEventListener('click', () => {
      const line = header.offsetHeight + 1;
      const current = sections().filter((el) => el.getBoundingClientRect().top <= line).pop();
      const max = document.documentElement.scrollHeight - innerHeight;
      const state = scrollY < 4 ? null : current
        ? { id: current.id, off: line - current.getBoundingClientRect().top, t: Date.now() }
        : { ratio: max > 0 ? scrollY / max : 0, t: Date.now() };
      try { state ? sessionStorage.setItem(SCROLL_KEY, JSON.stringify(state)) : sessionStorage.removeItem(SCROLL_KEY); } catch {}
    });
  });
  try {
    const saved = JSON.parse(sessionStorage.getItem(SCROLL_KEY) ?? 'null');
    sessionStorage.removeItem(SCROLL_KEY);
    if (saved && Date.now() - saved.t < 10000 && !location.hash) {
      const restore = () => {
        const el = saved.id ? document.getElementById(saved.id) : null;
        const top = el
          ? el.getBoundingClientRect().top + scrollY + saved.off - (header.offsetHeight + 1)
          : (document.documentElement.scrollHeight - innerHeight) * (saved.ratio ?? 0);
        scrollTo({ top, behavior: 'instant' });
      };
      restore();
      addEventListener('load', restore, { once: true });
    }
  } catch {}

  if (targets.length && /^\/(en\/?)?$/.test(location.pathname)) {
    const visible = new Map<string, number>();
    const mark = (current?: string) =>
      links.forEach((a) => (current && hashOf(a) === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        mark([...visible.entries()].filter(([, r]) => r > 0).sort((a, b) => b[1] - a[1])[0]?.[0]);
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.01, 0.25, 0.5, 1] },
    );
    new Set(targets).forEach((el) => io.observe(el));
  }
</script>
