---
import { Menu, X, ArrowRight } from '@lucide/astro';
import { site, nav, navProfile } from '../config/site';

const onProfile = Astro.url.pathname.replace(/\/$/, '') === navProfile.href;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur transition-shadow data-[scrolled]:shadow-[0_8px_24px_-16px_rgb(0_0_0/0.6)]" data-header>
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <!-- Marque -->
    <a href="/" class="flex shrink-0 items-center gap-2 font-display text-base font-semibold tracking-tight" aria-label={`${site.name}, accueil`}>
      <span>Elvis Pichou<span class="text-accent-fg">.</span></span>
    </a>

    <!-- Menu principal (≥ 1024 px) : entrées à plat, section visible soulignée (D-28) -->
    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a href={item.href} data-nav-link class="nav-link">
              {item.label}
            </a>
          </li>
        ))}
        <li aria-hidden="true" class="mx-2 h-4 w-px bg-line-strong"></li>
        <li>
          <a
            href={navProfile.href}
            aria-current={onProfile ? 'page' : undefined}
            class="nav-link"
            data-umami-event="profil-nav"
          >
            {navProfile.label}
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        data-theme-toggle
        class="grid size-10 place-items-center rounded-full border border-line-strong text-ink transition duration-300 hover:-rotate-12 hover:scale-105 hover:border-ink active:scale-95"
        aria-label="Passer en thème clair"
      >
        <svg data-icon-sun class="hidden size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg data-icon-moon class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <a href="/#contact" class="btn btn-primary !px-4 !py-2.5" data-umami-event="cta-header">
        <span class="xl:hidden">Contact</span><span class="hidden xl:inline">Parler de mon projet</span>
      </a>

      <button
        type="button"
        data-menu-toggle
        class="grid size-10 place-items-center rounded-full border border-line-strong text-ink transition duration-300 hover:scale-105 hover:border-ink active:scale-95 lg:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu data-icon-open class="size-5" aria-hidden="true" />
        <X data-icon-close class="hidden size-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Menu mobile (< 1024 px) : panneau plein écran sous l'en-tête, mêmes entrées que le menu principal -->
  <div id="mobile-menu" hidden class="absolute inset-x-0 top-full h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-line bg-bg lg:hidden">
    <nav aria-label="Navigation mobile" class="container-page flex min-h-full flex-col py-6">
      <ul class="divide-y divide-line">
        {nav.map((item, i) => (
          <li>
            <a href={item.href} data-nav-link data-mobile-link class="group flex items-center gap-4 py-4 font-heading text-xl font-semibold aria-[current=true]:text-accent-fg">
              <span aria-hidden="true" class="w-6 text-sm font-bold text-muted group-aria-[current=true]:text-accent-fg">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1">{item.label}</span>
              <ArrowRight class="size-5 text-muted" aria-hidden="true" />
            </a>
          </li>
        ))}
        <li>
          <a
            href={navProfile.href}
            data-mobile-link
            aria-current={onProfile ? 'page' : undefined}
            class="flex items-center gap-4 py-4 text-base font-semibold text-muted aria-[current=page]:text-ink"
          >
            <span class="w-6" aria-hidden="true"></span>
            <span class="flex-1">{navProfile.label}</span>
            <ArrowRight class="size-5" aria-hidden="true" />
          </a>
        </li>
      </ul>

      <div class="mt-auto flex flex-col gap-4 pt-8">
        <a href="/#contact" data-mobile-link class="btn btn-primary w-full" data-umami-event="cta-header-mobile">Parler de mon projet</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Entrée de menu à plat : texte atténué, section visible = texte plein + trait d'accent dessous. */
  .nav-link {
    position: relative;
    display: block;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
    transition: color 0.15s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.875rem;
    bottom: 0.125rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent-fg);
    transform: scaleX(0);
    transition: transform 0.2s ease-out;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link:hover::after {
    transform: scaleX(0.4);
  }
  .nav-link[aria-current='true'],
  .nav-link[aria-current='page'] {
    color: var(--color-ink);
  }
  .nav-link[aria-current='true']::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // ── Ombre sous l'en-tête dès que la page défile ──
  const syncScrolled = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', syncScrolled, { passive: true });
  syncScrolled();

  // ── Thème ──
  const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const sun = toggle.querySelector<SVGElement>('[data-icon-sun]')!;
  const moon = toggle.querySelector<SVGElement>('[data-icon-moon]')!;
  function syncTheme() {
    const light = root.dataset.theme === 'light';
    sun.classList.toggle('hidden', light);
    moon.classList.toggle('hidden', !light);
    toggle.setAttribute('aria-label', light ? 'Passer en thème sombre' : 'Passer en thème clair');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#f3f0e8' : '#0f1016');
  }
  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    syncTheme();
  });
  syncTheme();

  // ── Menu mobile : défilement de la page verrouillé, focus gardé dans l'en-tête, fermeture par Échap / lien / clic hors panneau ──
  const burger = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = burger.querySelector('[data-icon-open]')!;
  const iconClose = burger.querySelector('[data-icon-close]')!;
  const isOpen = () => !menu.hidden;

  function setMenu(open: boolean, returnFocus = false) {
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    root.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
    else if (returnFocus) burger.focus();
  }

  burger.addEventListener('click', () => setMenu(!isOpen()));
  menu.querySelectorAll('[data-mobile-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  menu.addEventListener('click', (e) => { if (e.target === menu) setMenu(false, true); });
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') return setMenu(false, true);
    if (e.key !== 'Tab') return;
    const items = [burger, ...menu.querySelectorAll<HTMLElement>('a')];
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // ── Section active : l'entrée correspondant à la section visible est marquée (page d'accueil uniquement) ──
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const hashOf = (a: HTMLAnchorElement) => new URL(a.href, location.href).hash.slice(1);
  const targets = links
    .map((a) => document.getElementById(hashOf(a)))
    .filter((el): el is HTMLElement => !!el);

  if (targets.length && location.pathname === '/') {
    const visible = new Map<string, number>();
    const mark = (current?: string) =>
      links.forEach((a) => (current && hashOf(a) === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        mark([...visible.entries()].filter(([, r]) => r > 0).sort((a, b) => b[1] - a[1])[0]?.[0]);
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.01, 0.25, 0.5, 1] },
    );
    new Set(targets).forEach((el) => io.observe(el));
  }
</script>
