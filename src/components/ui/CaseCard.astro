---
import type { CollectionEntry } from 'astro:content';
import BrowserFrame from './BrowserFrame.astro';
import { Image } from 'astro:assets';
import { Shield, Lock } from '@lucide/astro';
import { getScreenshot, getLogo } from '../../lib/assets';

interface Props {
  entry: CollectionEntry<'realisations'>;
}

const { entry } = Astro.props;
const logo = getLogo(entry.id);
const shot = getScreenshot(entry.id);
const d = entry.data;
const kindLabel = { site: 'Site vitrine', outil: 'Outil sur mesure', produit: 'Produit SaaS' }[d.kind];
---

<a
  href={`/realisations/${entry.id}`}
  class="group flex min-w-0 flex-col rounded-card border border-line bg-bg p-6 transition hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-xl hover:shadow-black/5 sm:p-7"
  data-umami-event="case-open"
  data-umami-event-case={entry.id}
>
  {shot && (
    <BrowserFrame
      class="mb-6"
      url={d.url}
      label={d.confidential ? 'application interne · confidentiel' : undefined}
      image={shot}
      alt={`Capture de ${d.client}`}
      ratio="aspect-[16/9]"
    />
  )}
  <div class="flex items-center gap-3">
    {!logo && entry.id === 'gendarmerie' && (
      <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-surface-2 text-accent-fg"><Shield class="size-5" aria-hidden="true" /></span>
    )}
    {logo && (
      <span data-audit-ignore="tuile logo toujours claire : les logos sombres restent lisibles en thème sombre" class="relative size-11 shrink-0 overflow-hidden rounded-xl bg-[#f3f0e8]">
        <Image src={logo} alt="" class="absolute inset-1.5 size-[calc(100%-0.75rem)] object-contain" />
      </span>
    )}
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px]">
      <span class="rounded-full bg-accent-soft px-2.5 py-1 font-medium text-accent-fg">{kindLabel}</span>
      <span class="text-muted">{d.client} · {d.sector}</span>
    </div>
  </div>
  <h3 class="mt-4 text-xl font-semibold">{d.title}</h3>
  <p class="mt-2 leading-relaxed text-muted">{d.summary}</p>
  {!shot && d.cardNote && <p class="mt-3 leading-relaxed text-muted">{d.cardNote}</p>}

  {!shot && d.keyFacts && (
    <div class="mt-6 rounded-2xl border border-line bg-surface-2 px-5 py-4">
      <p class="flex items-start gap-3 text-sm leading-snug font-semibold text-ink">
        <Lock class="mt-0.5 size-4 shrink-0 text-accent-fg" aria-hidden="true" />
        Applications internes : par confidentialité, je ne peux pas en montrer de capture.
      </p>
      <ul class="mt-4 divide-y divide-line border-t border-line">
        {d.keyFacts.map((f) => (
          <li class="py-3 leading-snug last:pb-0">
            <span class="mr-2 font-display text-lg font-semibold whitespace-nowrap text-accent-fg">{f.value}</span>
            <span class="text-[15px]">{f.label}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <span class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold">
    Lire l'étude de cas <span aria-hidden="true" class="text-accent-fg transition group-hover:translate-x-1">→</span>
  </span>
</a>
