---
import type { CollectionEntry } from 'astro:content';
import BrowserFrame from './BrowserFrame.astro';
import { Image } from 'astro:assets';
import { Shield, Lock } from '@lucide/astro';
import { getScreenshot, getLogo } from '../../lib/assets';
import { useI18n, localePath, fmt } from '../../i18n';

interface Props {
  entry: CollectionEntry<'realisations'>;
  /** Nom du fichier de l'étude, commun aux langues (sert aux images et à l'adresse). */
  slug: string;
}

const { entry, slug } = Astro.props;
const { lang, t } = useI18n(Astro.url);
const logo = getLogo(slug);
const shot = getScreenshot(slug);
const d = entry.data;
const kindLabel = t.common.caseKind[d.kind];
---

<a
  href={localePath(lang, `/realisations/${slug}`)}
  class="group lift flex min-w-0 flex-col rounded-card border border-line bg-bg p-5 sm:p-6"
  data-umami-event="case-open"
  data-umami-event-case={slug}
>
  {shot && (
    <BrowserFrame
      class="mb-4"
      url={d.url}
      label={d.confidential ? t.common.internalAppConfidential : undefined}
      image={shot}
      alt={fmt(t.caseCard.screenshotAlt, { client: d.client })}
      ratio="aspect-[21/9]"
    />
  )}
  <div class="flex items-center gap-3">
    {!logo && slug === 'gendarmerie' && (
      <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-surface-2 text-accent-fg"><Shield class="size-5" aria-hidden="true" /></span>
    )}
    {logo && (
      <span data-audit-ignore="tuile logo toujours claire : les logos sombres restent lisibles en thème sombre" class="relative size-11 shrink-0 overflow-hidden rounded-xl bg-[#f3f0e8]">
        <Image src={logo} alt="" class="absolute inset-1.5 size-[calc(100%-0.75rem)] object-contain" />
      </span>
    )}
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px]">
      <span class="rounded-full bg-accent-soft px-2.5 py-1 font-medium text-accent-fg">{kindLabel}</span>
      <span class="text-muted">{d.client} · {d.sector}</span>
    </div>
  </div>
  <h3 class="mt-3 text-xl font-semibold">{d.title}</h3>
  {shot ? (
    <p class="mt-1.5 leading-relaxed text-muted max-sm:line-clamp-4">{d.summary}</p>
  ) : (
    <>
      {/* Téléphone : chiffres empilés dans un encadré, séparés par des filets ; dès 640 px, trois colonnes. */}
      {d.keyFacts && (
        <ul class="mt-4 divide-y divide-line rounded-2xl bg-surface px-4 sm:grid sm:grid-cols-[0.9fr_1.4fr_1fr] sm:gap-x-4 sm:divide-y-0 sm:rounded-none sm:bg-transparent sm:px-0">
          {d.keyFacts.map((f) => (
            <li class="py-3 leading-snug sm:py-0">
              <span class="block font-display text-xl font-semibold whitespace-nowrap text-accent-fg sm:text-2xl">{f.value}</span>
              <span class="mt-0.5 block text-sm text-muted sm:mt-1 sm:text-[15px]">{f.label}</span>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-4 leading-relaxed text-muted">{d.cardNote ?? d.summary}</p>
      <p class="mt-4 flex items-start gap-2.5 border-t border-line pt-4 text-sm leading-snug font-semibold text-ink">
        <Lock class="mt-0.5 size-4 shrink-0 text-accent-fg" aria-hidden="true" />
        {t.caseCard.confidentialNote}
      </p>
    </>
  )}

  <span class="mt-auto inline-flex items-center gap-2 pt-4 text-sm font-semibold">
    {t.caseCard.read} <span aria-hidden="true" class="text-accent-fg transition group-hover:translate-x-1">→</span>
  </span>
</a>
