---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useI18n } from '../../i18n';

interface Props {
  /** Adresse affichée dans la barre (host seul). Sans URL, `label` est affiché. */
  url?: string;
  label?: string;
  image?: ImageMetadata;
  alt?: string;
  ratio?: string;
  class?: string;
}

const { t } = useI18n(Astro.url);
const { url, label = t.common.internalApp, image, alt = '', ratio = 'aspect-[16/10]', class: className } = Astro.props;
const host = url ? new URL(url).host : label;
---

<div class:list={['overflow-hidden rounded-2xl border border-line bg-surface', className]}>
  <div class="flex items-center gap-2 border-b border-line px-3.5 py-2.5">
    <span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span>
    <span class="ml-2 flex-1 truncate rounded-md bg-surface-2 px-3 py-1 font-mono text-[13px] text-muted">{host}</span>
  </div>
  <div class:list={[ratio, 'bg-surface-2']}>
    {image ? (
      <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 560px, 90vw" class="size-full object-cover object-top transition duration-700 ease-out group-hover:scale-105" />
    ) : (
      // Repère visuel tant qu'il n'y a pas de capture : maquette abstraite, masquée aux lecteurs d'écran.
      <div class="flex size-full flex-col gap-3 p-6" aria-hidden="true">
        <div class="h-2.5 w-1/4 rounded-full bg-accent"></div>
        <div class="h-5 w-4/5 rounded-full bg-ink/80"></div>
        <div class="h-3 w-3/5 rounded-full bg-muted/40"></div>
        <div class="mt-2 flex gap-2"><div class="h-8 w-24 rounded-full bg-accent"></div><div class="h-8 w-16 rounded-full border border-line"></div></div>
        <div class="mt-auto grid grid-cols-3 gap-2"><div class="h-14 rounded-xl bg-surface"></div><div class="h-14 rounded-xl bg-surface"></div><div class="h-14 rounded-xl bg-surface"></div></div>
      </div>
    )}
  </div>
</div>
