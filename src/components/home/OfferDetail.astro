---
import { offers } from '../../data/offers';
import { ArrowRight } from '@lucide/astro';
---

<section id="offre" class="border-y border-line bg-surface pt-10 pb-16 sm:pt-12 sm:pb-20" data-offers>
  <div class="container-page">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <h2 class="text-3xl font-medium sm:text-4xl">Ce que je fais pour vous</h2>
      <div role="tablist" aria-label="Choisir une offre" class="flex max-w-full flex-col gap-1.5 rounded-[1.6rem] border border-line bg-bg p-1.5 sm:inline-flex sm:flex-row sm:self-start sm:rounded-full">
        {offers.map((o, i) => {
          const TabIcon = o.tabIcon;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${o.id}`}
              data-offer={o.id}
              aria-controls={`offre-${o.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-bold transition duration-200 active:scale-95 aria-selected:bg-accent aria-selected:text-accent-ink hover:not-aria-selected:-translate-y-0.5 hover:not-aria-selected:bg-surface hover:not-aria-selected:text-accent-fg"
              data-umami-event="offre-tab"
              data-umami-event-offre={o.id}
            >
              <TabIcon class="size-4" aria-hidden="true" />{o.tab}
            </button>
          );
        })}
      </div>
    </div>

    {offers.map((o, i) => (
      <div
        role="tabpanel"
        id={`offre-${o.id}`}
        aria-labelledby={`tab-${o.id}`}
        data-panel
        data-offer={o.id}
        hidden={i !== 0}
        tabindex="0"
        class="mt-10 focus-visible:outline-none"
      >
        <div class="grid gap-x-16 gap-y-10 lg:grid-cols-[5fr_6fr] lg:grid-rows-[auto_1fr_auto] lg:gap-y-6">
          <!-- Accroche -->
          <div class="lg:col-start-1 lg:row-start-1">
            <p class="inline-flex rounded-full bg-ink px-4 py-1.5 text-sm font-bold tracking-[0.06em] text-bg uppercase">{o.audience}</p>
            <h3 class="mt-4 font-sans text-2xl leading-[1.2] font-semibold sm:text-3xl">{o.headline}</h3>
            <p class="mt-3 text-lg leading-relaxed text-muted">{o.intro}</p>
            <p class="mt-4 text-base leading-snug"><span class="font-semibold">Par exemple :</span> <span class="text-muted">{o.examples}</span></p>
          </div>

          <!-- Bénéfices -->
          <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
            <h4 class="font-sans text-xl font-semibold">Ce que ça change pour vous</h4>
            <ul class="mt-3">
              {o.why.map((w) => {
                const WhyIcon = w.icon;
                return (
                  <li class="flex gap-4 border-t border-line py-4 first:border-t-0 first:pt-2">
                    <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-accent-soft text-accent-fg">
                      <WhyIcon class="size-6" aria-hidden="true" />
                    </span>
                    <div>
                      <h5 class="font-heading text-lg leading-tight font-semibold tracking-tight">{w.title}</h5>
                      <p class="mt-1 text-base leading-snug text-muted">{w.text}</p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Méthode : frise pleine largeur, mêmes pastilles d'icône que les raisons -->
          <div class="border-t border-line pt-6 lg:col-span-2 lg:row-start-3">
            <h4 class="font-sans text-xl font-semibold">Comment je travaille</h4>
            <ol class="mt-4 grid gap-8 md:grid-cols-3 md:gap-x-8">
              {o.steps.map((s, k) => {
                const StepIcon = s.icon;
                return (
                  <li>
                    <div class="flex items-center gap-4">
                      <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-accent-soft text-accent-fg">
                        <StepIcon class="size-6" aria-hidden="true" />
                      </span>
                      {k < o.steps.length - 1 && <span class="hidden h-px flex-1 bg-line-strong md:block" aria-hidden="true"></span>}
                    </div>
                    <p class="mt-4 text-xs font-bold tracking-[0.08em] text-accent-fg uppercase">Étape {k + 1}</p>
                    <h5 class="mt-1 font-heading text-lg leading-tight font-semibold tracking-tight">{s.title}</h5>
                    <p class="mt-2 text-base leading-snug text-muted">{s.text}</p>
                  </li>
                );
              })}
            </ol>
          </div>

          <!-- Appel à l'action : à côté de la promesse sur grand écran, après la méthode sur mobile -->
          <div class="lg:col-start-1 lg:row-start-2 lg:self-start">
            <a href={o.cta.href} class="btn btn-primary !px-7 !py-4 !text-base" data-umami-event={`cta-offre-${o.id}`}>
              {o.cta.label} <ArrowRight class="size-5" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    ))}
    <noscript><style>[data-panel][hidden] { display: block !important; }</style></noscript>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-offers]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const ids = tabs.map((t) => t.dataset.offer!);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function select(id: string) {
      tabs.forEach((t) => {
        const on = t.dataset.offer === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => (p.hidden = p.dataset.offer !== id));
    }
    const scrollToOffers = () => root!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    const fromHash = () => {
      const id = location.hash.replace('#offre-', '');
      if (location.hash.startsWith('#offre-') && ids.includes(id)) { select(id); scrollToOffers(); }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        select(tab.dataset.offer!);
        history.replaceState(null, '', `#offre-${tab.dataset.offer}`);
      });
      tab.addEventListener('keydown', (e) => {
        const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        const target = tabs[(next + tabs.length) % tabs.length];
        target.focus(); target.click();
      });
    });

    // Clic sur une carte d'offre (accueil) ou lien externe vers #offre-… : bascule l'onglet puis défile.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#offre-"]');
      if (!a) return;
      const id = a.getAttribute('href')!.split('#offre-')[1];
      if (!ids.includes(id)) return;
      e.preventDefault();
      select(id);
      history.pushState(null, '', `#offre-${id}`);
      scrollToOffers();
    });
    addEventListener('hashchange', fromHash);
    if (location.hash.startsWith('#offre-')) setTimeout(fromHash, 50);
  }
</script>
