---
import { Image } from 'astro:assets';
import { ArrowRight, Check, MapPin } from '@lucide/astro';
import { getPhoto } from '../../lib/assets';

const photo = getPhoto();

// Ordre voulu par Elvis (D-37) : l'outil sur mesure d'abord (prioritaire, carte en accent), le site vitrine ensuite.
const offers = [
  {
    id: 'outil',
    num: '01',
    target: 'TPE, PME',
    title: 'Vous perdez du temps dans des processus ?',
    pitch: 'Devis, planning, suivi client éparpillés : un outil sur mesure s’adapte à votre façon de travailler.',
    points: ['Construit autour de votre métier', 'Chacun voit ce qui le concerne', 'Prototype validé avant de construire'],
    cta: 'Automatiser mon activité',
  },
  {
    id: 'site',
    num: '02',
    target: 'Indépendants, commerçants',
    title: 'Vos clients ne vous trouvent pas ?',
    pitch: 'Un site clair et rapide, pensé pour être trouvé sur internet et donner envie d’appeler.',
    // FACTICE : délai provisoire, à confirmer par Elvis avant la mise en ligne (D-37).
    points: ['Livré en 3 semaines', 'Adapté au mobile', 'Hébergement et suivi inclus'],
    cta: 'Me rendre visible',
  },
];
---

<section id="accueil" class="pt-8 pb-16 sm:pt-12 lg:flex lg:min-h-[calc(100svh-4rem)] lg:py-14 tall:py-6">
  <div class="container-page flex flex-col gap-10 lg:justify-between lg:gap-12 tall:gap-8">
    <div class="grid gap-x-12 gap-y-6 lg:gap-x-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      {/* Identité : photo, métier et preuve, regroupés sur le côté (D-44). Sur mobile : au-dessus du titre. */}
      <div data-reveal="right" data-reveal-delay="200" class="order-first flex items-center gap-4 lg:order-none lg:col-start-2 lg:row-start-1 lg:gap-8 tall:w-[270px] tall:flex-col tall:items-start tall:gap-8">
        {/* Le conteneur ne rogne pas : la pastille de lieu dépasse à moitié sous la photo (D-56). */}
        <div class="relative size-[72px] shrink-0 sm:size-20 lg:size-auto lg:aspect-[4/5] lg:w-[150px] tall:aspect-auto tall:h-[280px] tall:w-full">
          <div class="absolute inset-0 overflow-hidden rounded-2xl border border-line bg-surface-2 lg:rounded-card">
            {photo ? (
              <Image src={photo} alt="Elvis Pichou, développeur web freelance" widths={[270, 540]} sizes="(min-width: 1024px) 270px, 80px" loading="eager" fetchpriority="high" class="size-full object-cover object-[50%_20%]" />
            ) : (
              // Sans photo : monogramme (comme « Qui je suis »). En développement, rappel du fichier attendu.
              <div class="grid size-full place-items-center">
                <span class="font-display text-2xl font-semibold text-accent-fg lg:text-5xl" aria-hidden="true">EP</span>
                {import.meta.env.DEV && (
                  <p class="absolute inset-x-2 bottom-2 hidden rounded-xl border border-dashed border-line-strong p-1.5 text-center text-[13px] leading-tight text-muted lg:block">
                    <code>src/assets/elvis.jpg</code>
                  </p>
                )}
              </div>
            )}
          </div>
          <p class="absolute -bottom-4 left-1/2 hidden -translate-x-1/2 items-center gap-1.5 rounded-full border border-line bg-bg px-3.5 py-1.5 text-[13px] leading-snug font-bold whitespace-nowrap tall:inline-flex">
            <MapPin class="size-4 shrink-0 text-accent-fg" aria-hidden="true" />Toulouse · 100 % à distance
          </p>
        </div>
        <div class="min-w-0">
          <p class="eyebrow max-w-[11rem] text-sm sm:max-w-[12rem] sm:text-base tall:max-w-none tall:text-sm tall:tracking-wider">Développeur web freelance</p>
          <p class="mt-3 text-base font-semibold sm:text-lg tall:mt-3 tall:text-[15px]">Depuis 2021 dans le web</p>
          <p class="mt-1 text-sm leading-snug text-muted lg:whitespace-nowrap xl:text-base tall:mt-1 tall:text-[15px]">4 ans pour la Gendarmerie nationale</p>
          <p class="mt-4 tall:hidden inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-[13px] leading-snug font-bold whitespace-nowrap">
            <MapPin class="size-4 shrink-0 text-accent-fg" aria-hidden="true" />Toulouse · 100 % à distance
          </p>
        </div>
      </div>

      <div class="@container min-w-0 lg:col-start-1 lg:row-start-1">
        <h1 data-reveal="title" data-reveal-delay="80" class="w-full font-display text-[clamp(1.05rem,5.4cqw,2.9rem)] leading-[1.5] font-normal">
          <span class="sr-only">Je conçois des outils web qui simplifient le travail des entreprises.</span>
          <span aria-hidden="true">
            Je conçois des outils web qui
            <span class="block h-[1.3em] overflow-hidden text-[clamp(1.6rem,10.8cqw,6.5rem)] leading-[1.3] font-semibold whitespace-nowrap text-accent-fg">
              <span data-verb class="inline-block">simplifient</span>
            </span>
            le travail des entreprises.
          </span>
        </h1>
      </div>
    </div>

    {/* Cartes + accès profil forment un seul groupe serré (D-53) ; l'espace libre reste entre ce groupe et le titre. */}
    <div class="flex flex-col gap-6 lg:gap-5">
    <div class="relative grid gap-4 lg:grid-cols-2">
      {offers.map((o, i) => (
        <>
          <article
            data-reveal="zoom"
            data-reveal-delay={i === 0 ? '350' : '500'}
            class:list={[
              'group lift relative flex flex-col rounded-card p-7 sm:p-9',
              i === 0
                ? 'bg-accent pb-20 text-accent-ink lg:pb-9'
                : 'border border-line-strong bg-surface-2 pt-16 text-ink lg:pt-9',
            ]}
          >
            <span
              class="absolute top-0 left-7 z-10 max-w-[11rem] -translate-y-1/2 rounded-2xl bg-ink px-4 py-1.5 text-center text-sm leading-tight font-bold tracking-wide text-bg uppercase xl:text-[15px] ring-4 ring-bg sm:left-9 sm:max-w-none sm:rounded-full sm:whitespace-nowrap"
            >
              {o.target}
            </span>
            <div class="flex items-start gap-3">
              <span class="font-display text-3xl leading-none font-semibold xl:text-4xl">{o.num}</span>
              <h2 class="font-heading text-2xl leading-tight font-semibold tracking-tight xl:text-[clamp(1.25rem,1.9vw,1.625rem)]">{o.title}</h2>
            </div>
            <div class:list={['flex flex-1 flex-col', i === 0 ? 'lg:pr-6' : 'lg:pl-6']}>
              <p
                class:list={[
                  'mt-5 rounded-2xl px-5 py-4 text-base leading-relaxed xl:text-lg lg:flex lg:min-h-[5.5rem] lg:items-center',
                  i === 0 ? 'bg-[color-mix(in_srgb,var(--color-accent)_78%,black)]' : 'bg-surface',
                ]}
              >
                {o.pitch}
              </p>
              <hr class:list={['mt-6 border-t-2', i === 0 ? 'border-accent-ink' : 'border-line-strong']} />
              <ul class="mt-5 mb-6 space-y-2 text-[15px] leading-relaxed xl:text-base">
                {o.points.map((p) => (
                  <li class="flex items-start gap-2">
                    <Check class="mt-[3px] size-[18px] shrink-0" aria-hidden="true" />
                    {p}
                  </li>
                ))}
              </ul>
              <a
                href={`#offre-${o.id}`}
                class:list={[
                  'mt-auto flex w-full items-center justify-center gap-3 self-start rounded-full px-6 py-3.5 text-base font-bold whitespace-nowrap transition duration-200 group-hover:brightness-110 group-hover:shadow-[0_12px_26px_-10px_rgb(0_0_0/0.5)] group-active:scale-[0.97] after:absolute after:inset-0 after:rounded-card sm:w-auto',
                  // Sur la carte accent : pastille blanche, texte en accent (≥ 5,5:1 sur les deux thèmes, la pastille ink tombait à 2,9:1 en clair).
                  i === 0 ? 'bg-accent-ink text-accent' : 'bg-ink text-bg',
                ]}
                data-umami-event={`offre-${o.id}`}
              >
                {o.cta} <ArrowRight class="size-5 shrink-0 transition group-hover:translate-x-1" aria-hidden="true" />
              </a>
            </div>
          </article>

          {i === 0 && (
            /* Le dé : dans le flux entre les cartes empilées (à droite, pour ne pas chevaucher le badge de la carte 2), centré sur la jointure côte à côte. */
            <div class="pointer-events-none relative z-10 -my-[54px] flex justify-end pr-3 sm:pr-8 md:-my-[62px] lg:absolute lg:inset-0 lg:m-0 lg:items-center lg:justify-center lg:pr-0">
              <button
                type="button"
                data-die-btn
                data-reveal="pop" data-reveal-delay="800" class="pointer-events-auto grid cursor-pointer place-items-center rounded-full bg-bg p-2.5 transition duration-300 hover:scale-110 hover:-rotate-12 active:scale-95"
                aria-label="Lancer le dé pour changer le verbe du titre"
              >
                <canvas data-die width="208" height="208" class="size-[88px] text-ink md:size-[104px]" aria-hidden="true"></canvas>
              </button>
              <p class="sr-only" role="status" data-die-status></p>
            </div>
          )}
        </>
      ))}
    </div>

    {/* Accès profil : volontairement discret (D-45), sans bordure, plus petit que les offres. */}
    <div data-reveal="up" data-reveal-delay="650" class="flex flex-col gap-4 rounded-card bg-surface px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <div>
        <h2 class="font-heading text-base font-semibold sm:text-lg">Vous voulez en savoir plus sur mes compétences ?</h2>
        <p class="mt-1 text-[15px] text-muted">Technologies maîtrisées, expériences, disponibilité : tout se trouve sur mon profil.</p>
      </div>
      <a href="/profil" class="btn btn-ghost shrink-0 px-6 py-3 text-sm" data-umami-event="profil-home">
        Voir mon profil technique <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </div>
    </div>
  </div>
</section>

<style is:global>
  /* Verbe « tableau d'aéroport » : le mot entier roule vers le haut, le suivant monte du bas. */
  .flip-col { display: block; transition: transform .6s cubic-bezier(.7, 0, .2, 1); }
  .flip-word { display: block; height: 1.3em; line-height: 1.3; white-space: nowrap; }
</style>

<script>
  import { createDie } from '../../lib/die';

  // Un 20 donne toujours « simplifient » (D-12). « automatisent » = offre outil, « rendent visible » = offre site (D-39).
  const VERBS = ['simplifient', 'automatisent', 'rendent visible', 'accélèrent', 'organisent'];
  const canvas = document.querySelector<HTMLCanvasElement>('[data-die]');
  const button = document.querySelector<HTMLButtonElement>('[data-die-btn]');
  const verb = document.querySelector<HTMLElement>('[data-verb]');
  const headline = verb?.closest('h1');
  const status = document.querySelector<HTMLElement>('[data-die-status]');

  if (canvas && button && verb) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 600;
    let current = verb.textContent ?? VERBS[0];
    let swapping = false;

    // Tableau d'affichage : le mot entier roule (l'ancien sort par le haut, le nouveau monte du bas).
    // Avec « mouvement réduit », le verbe change sans animation (le texte qui change n'est pas un mouvement).
    function setVerb(next: string) {
      if (swapping || next === current) return;
      if (reduced) { verb!.textContent = current = next; return; }
      swapping = true;
      const col = document.createElement('span');
      col.className = 'flip-col';
      for (const word of [current, next]) {
        const w = document.createElement('span');
        w.className = 'flip-word';
        w.textContent = word;
        col.append(w);
      }
      verb!.textContent = '';
      verb!.append(col);
      void verb!.offsetWidth; // force le calcul du style avant de lancer la transition
      col.style.transform = 'translateY(-50%)';
      setTimeout(() => {
        verb!.textContent = current = next;
        swapping = false;
      }, DURATION + 60);
    }

    // Rotation automatique : un verbe toutes les 4 s, pendant 5 tours complets (≈ 100 s), puis arrêt.
    // En pause tant que la souris est sur le titre. (Pas de test « onglet masqué » : certains navigateurs intégrés se déclarent masqués à tort et la rotation ne partait jamais.)
    let paused = false;
    let ticks = 0;
    const MAX_TICKS = VERBS.length * 5;
    const timer = setInterval(() => {
      if (ticks >= MAX_TICKS) return clearInterval(timer);
      if (paused || swapping) return;
      ticks++;
      setVerb(VERBS[(VERBS.indexOf(current) + 1) % VERBS.length]);
    }, 4000);
    headline?.addEventListener('pointerenter', () => (paused = true));
    headline?.addEventListener('pointerleave', () => (paused = false));

    const die = createDie(canvas, {
      reducedMotion: reduced,
      onResult(value) {
        let next = value === 20 ? VERBS[0] : VERBS[value % VERBS.length];
        if (next === current) next = VERBS[(VERBS.indexOf(next) + 1) % VERBS.length];
        setVerb(next);
        if (status) status.textContent = `Dé : ${value}. Le verbe du titre est « ${next} ».`;
      },
    });

    button.addEventListener('click', () => {
      die.roll();
      (window as any).umami?.track('die-roll');
    });
    if (!reduced) setTimeout(die.roll, 900);
  }
</script>
