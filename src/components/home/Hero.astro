---
import { Image } from 'astro:assets';
import { ArrowRight, Check, MapPin, Pause, Play } from '@lucide/astro';
import DiceWizard from './DiceWizard.astro';
import { getPhoto } from '../../lib/assets';
import { useI18n, localePath } from '../../i18n';

const photo = getPhoto();

const { lang, t } = useI18n(Astro.url);
const h = t.hero;

// Ordre voulu par Elvis (D-37) : l'outil sur mesure d'abord (prioritaire, carte en accent), le site vitrine ensuite.
const offers = (['outil', 'site'] as const).map((id, i) => ({ id, num: `0${i + 1}`, ...h.cards[id] }));

// Textes du script (verbe du titre, bouton pause, dé) : lus depuis l'attribut data-i18n de la section.
const scriptTexts = {
  verbs: h.verbs, pauseLabel: h.pauseLabel, resumeLabel: h.resumeLabel, pauseTip: h.pauseTip, pausedTip: h.pausedTip, dieStatus: h.dieStatus,
};
---

<section id="accueil" data-i18n={JSON.stringify(scriptTexts)} class="pt-6 pb-10 sm:pt-12 sm:pb-16 lg:flex lg:min-h-[min(calc(100svh-4rem),66rem)] lg:py-14 tall:py-6">
  <div class="container-page flex flex-col gap-8 sm:gap-10 lg:justify-between lg:gap-12 tall:gap-8">
    <div class="grid gap-x-12 gap-y-6 lg:gap-x-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      {/* Identité : photo, métier et preuve, regroupés sur le côté (D-44). Sur mobile : au-dessus du titre. */}
      <div data-reveal="right" data-reveal-delay="200" class="order-first flex items-center gap-5 lg:order-none lg:col-start-2 lg:row-start-1 lg:gap-8 tall:w-[270px] tall:flex-col tall:items-start tall:gap-8">
        {/* Le conteneur ne rogne pas : la pastille de lieu dépasse à moitié sous la photo (D-56). */}
        <div class="relative aspect-[4/5] w-28 shrink-0 sm:w-32 lg:w-[150px] tall:aspect-auto tall:h-[280px] tall:w-full">
          <div class="absolute inset-0 overflow-hidden rounded-2xl border border-line bg-surface-2 lg:rounded-card">
            {photo ? (
              <Image src={photo} alt={h.photoAlt} widths={[270, 540]} sizes="(min-width: 1024px) 270px, 128px" loading="eager" fetchpriority="high" class="size-full object-cover object-[50%_20%]" />
            ) : (
              // Sans photo : monogramme (comme sur /profil). En développement, rappel du fichier attendu.
              <div class="grid size-full place-items-center">
                <span class="font-display text-2xl font-semibold text-accent-fg lg:text-5xl" aria-hidden="true">EP</span>
                {import.meta.env.DEV && (
                  <p class="absolute inset-x-2 bottom-2 hidden rounded-xl border border-dashed border-line-strong p-1.5 text-center text-[13px] leading-tight text-muted lg:block">
                    <code>src/assets/elvis.jpg</code>
                  </p>
                )}
              </div>
            )}
          </div>
          <p class="absolute -bottom-4 left-1/2 hidden -translate-x-1/2 items-center gap-1.5 rounded-full border border-line bg-bg px-3.5 py-1.5 text-[13px] leading-snug font-bold whitespace-nowrap tall:inline-flex">
            <MapPin class="size-4 shrink-0 text-accent-fg" aria-hidden="true" />{h.locationPill}
          </p>
        </div>
        <div class="min-w-0">
          <p class="eyebrow max-w-[11rem] text-sm sm:max-w-[12rem] sm:text-base tall:max-w-none tall:text-sm tall:tracking-wider">{h.eyebrow}</p>
          <p class="mt-3 text-base font-semibold sm:text-lg tall:mt-3 tall:text-[15px]">{h.since}</p>
          <p class="mt-1 text-sm leading-snug text-muted lg:whitespace-nowrap xl:text-base tall:mt-1 tall:text-[15px]">{h.gendarmerie}</p>
          <p class="mt-4 tall:hidden inline-flex max-w-full items-center gap-1.5 rounded-2xl border border-line px-3 py-1.5 text-[13px] leading-snug font-bold min-[400px]:rounded-full min-[400px]:whitespace-nowrap">
            <MapPin class="size-4 shrink-0 text-accent-fg" aria-hidden="true" />{h.locationPill}
          </p>
        </div>
      </div>

      <div class="@container relative min-w-0 lg:col-start-1 lg:row-start-1">
        <h1 data-reveal="title" data-reveal-delay="80" class="w-full font-display text-[clamp(1.05rem,5.4cqw,2.9rem)] leading-[1.5] font-normal">
          <span class="sr-only">{h.titleBefore} {h.verbs[0]} {h.titleAfter}</span>
          <span aria-hidden="true">
            {h.titleBefore}
            <span class="block h-[1.3em] overflow-hidden text-[clamp(1.6rem,10.8cqw,6.5rem)] leading-[1.3] font-semibold whitespace-nowrap text-accent-fg">
              <span data-verb class="inline-block">{h.verbs[0]}</span>
            </span>
            <span data-title-end>{h.titleAfter}</span>
          </span>
        </h1>
        {/* Contrôle de l'animation du verbe (RGAA 13.8) : posé par script juste après la dernière ligne du titre (texte fixe, jamais recouvert par le verbe). */}
        <button type="button" data-verb-pause aria-pressed="false" class="group absolute top-0 left-0 inline-grid size-6 place-items-center rounded-full text-muted transition before:absolute before:-inset-2.5 before:content-[''] hover:text-ink">
          <Pause class="size-3.5" data-icon-pause aria-hidden="true" /><Play class="hidden size-3.5" data-icon-play aria-hidden="true" />
          <span class="sr-only" data-verb-pause-label>{h.pauseLabel}</span>
          <span aria-hidden="true" data-verb-pause-tip class="pointer-events-none invisible absolute top-full right-0 z-20 mt-2 rounded-lg bg-ink px-3 py-1.5 text-[13px] leading-snug font-semibold whitespace-nowrap text-bg opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-visible:visible group-focus-visible:opacity-100 data-[show]:visible data-[show]:opacity-100">
            {h.pauseTip}
          </span>
        </button>
      </div>
    </div>

    {/* Cartes + accès profil forment un seul groupe serré (D-53) ; l'espace libre reste entre ce groupe et le titre.
        Téléphone : deux cartes distinctes empilées, badge dans la carte, sans dé (D-119). Tablette : côte à côte, comme sur bureau. */}
    <div class="flex flex-col gap-5 sm:gap-6 lg:gap-5">
    <div data-die-stage class="relative grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-4">
      {offers.map((o, i) => (
        <>
          <article
            data-reveal="zoom"
            data-reveal-delay={i === 0 ? '350' : '500'}
            class:list={[
              'group lift relative flex min-w-0 flex-col rounded-card p-6 min-[400px]:p-7 lg:p-9',
              i === 0
                ? 'bg-accent text-accent-ink md:pb-7 lg:pb-9'
                : 'border border-line-strong bg-surface-2 text-ink md:pt-7 lg:pt-9',
            ]}
          >
            <span
              class="mb-4 self-start rounded-full bg-ink px-4 py-1.5 text-sm leading-tight font-bold tracking-wide text-bg uppercase md:absolute md:top-0 md:left-7 md:z-10 md:mb-0 md:-translate-y-1/2 md:whitespace-nowrap md:ring-4 md:ring-bg lg:left-9 xl:text-[15px]"
            >
              {o.target}
            </span>
            <div class="flex items-start gap-3">
              <span class="font-display text-3xl leading-none font-semibold xl:text-4xl">{o.num}</span>
              <h2 class="font-heading text-[1.375rem] leading-tight font-semibold tracking-tight md:min-h-[3.75em] md:text-2xl lg:min-h-[2.5em] xl:text-[clamp(1.25rem,1.9vw,1.625rem)]">{o.title}</h2>
            </div>
            <div class:list={['flex flex-1 flex-col', i === 0 ? 'lg:pr-6' : 'lg:pl-6']}>
              {/* Téléphone : la promesse sans encadré ; tablette et bureau : encadré. */}
              <p
                class:list={[
                  'mt-3 text-base leading-relaxed md:mt-5 md:rounded-2xl md:px-5 md:py-4 xl:text-lg lg:flex lg:min-h-[5.5rem] lg:items-center',
                  i === 0 ? 'md:bg-[color-mix(in_srgb,var(--color-accent)_78%,black)]' : 'md:bg-surface',
                ]}
              >
                {o.pitch}
              </p>
              <hr class:list={['mt-6 hidden border-t-2 md:block', i === 0 ? 'border-accent-ink' : 'border-line-strong']} />
              <ul class="mt-4 mb-5 space-y-1.5 text-[15px] leading-snug md:mt-5 md:mb-6 md:space-y-2 md:leading-relaxed xl:text-base">
                {o.points.map((p) => (
                  <li class="flex items-start gap-2">
                    <Check class="mt-[2px] size-4 shrink-0 md:mt-[3px] md:size-[18px]" aria-hidden="true" />
                    {p}
                  </li>
                ))}
              </ul>
              <a
                href={`#offre-${o.id}`}
                class:list={[
                  'mt-auto flex w-full items-center justify-center gap-3 self-start rounded-full px-6 py-3.5 text-center text-base font-bold transition duration-200 sm:whitespace-nowrap group-hover:brightness-110 group-hover:shadow-[0_12px_26px_-10px_rgb(0_0_0/0.5)] group-active:scale-[0.97] after:absolute after:inset-0 after:rounded-card sm:w-auto',
                  // Sur la carte accent : pastille blanche, texte en accent (≥ 5,5:1 sur les deux thèmes, la pastille ink tombait à 2,9:1 en clair).
                  i === 0 ? 'bg-accent-ink text-accent' : 'bg-ink text-bg',
                ]}
                data-umami-event={`offre-${o.id}`}
              >
                {o.cta} <ArrowRight class="size-5 shrink-0 transition group-hover:translate-x-1" aria-hidden="true" />
              </a>
            </div>
          </article>

          {i === 0 && (
            /* Le dé : centré sur la jointure des cartes côte à côte (tablette, bureau) ; absent sur téléphone, où les cartes sont empilées (D-119). */
            <div class="pointer-events-none absolute inset-0 z-10 hidden items-center justify-center md:flex">
              <div class="relative">
                {/* Calque des effets du défi (D-130) : les triangles et anneaux partent du centre du dé ; l'étiquette annonce le résultat d'un lancer direct. */}
                <div data-die-fx aria-hidden="true" class="pointer-events-none absolute inset-0 z-20"></div>
                <span data-die-label aria-hidden="true" class="die-label pointer-events-none absolute bottom-full left-1/2 z-30 mb-2 rounded-full bg-ink px-3.5 py-1.5 text-[13px] leading-tight font-bold whitespace-nowrap text-bg" hidden></span>
                <button
                  type="button"
                  data-die-btn
                  data-reveal="pop" data-reveal-delay="800" class="pointer-events-auto grid cursor-pointer place-items-center rounded-full bg-bg p-2.5 transition duration-300 hover:scale-110 hover:-rotate-12 active:scale-95"
                  aria-label={h.dieLabel}
                >
                  <canvas data-die width="208" height="208" class="size-[104px] text-ink" aria-hidden="true"></canvas>
                </button>
                {/* « ? » : ouvre le petit défi du dé (D-130). Zone tactile de 40 px par le pseudo-élément. */}
                <button
                  type="button"
                  data-wizard-open
                  data-reveal="pop" data-reveal-delay="1100"
                  aria-haspopup="dialog" aria-expanded="false" aria-controls="de-wizard"
                  aria-label={h.wizard.openLabel}
                  class="wiz-hint group pointer-events-auto absolute top-0 -right-1 z-10 grid size-7 place-items-center rounded-full bg-ink text-sm leading-none font-bold text-bg ring-4 ring-bg transition duration-200 before:absolute before:-inset-1.5 before:content-[''] hover:scale-110 active:scale-95"
                >
                  <span aria-hidden="true">?</span>
                  <span aria-hidden="true" class="pointer-events-none invisible absolute right-0 bottom-full mb-2 rounded-lg bg-ink px-3 py-1.5 text-[13px] leading-snug font-semibold whitespace-nowrap text-bg opacity-0 ring-1 ring-line-strong transition group-hover:visible group-hover:opacity-100 group-focus-visible:visible group-focus-visible:opacity-100">{h.wizard.openTip}</span>
                </button>
              </div>
              <p class="sr-only" role="status" data-die-status></p>
            </div>
          )}
        </>
      ))}
    </div>

    {/* Accès profil : volontairement discret (D-45), sans bordure, plus petit que les offres.
        Téléphone : une ligne fine (question + flèche), tout le bloc est touchable (D-119). */}
    <div data-reveal="up" data-reveal-delay="650" class="relative flex items-center justify-between gap-4 rounded-2xl bg-surface px-4 py-3 sm:rounded-card sm:px-8 sm:py-5">
      <div class="min-w-0">
        <h2 class="font-heading text-[15px] leading-snug font-semibold sm:text-lg">{h.profileTitle}</h2>
        <p class="mt-1 hidden text-[15px] text-muted sm:block">{h.profileText}</p>
      </div>
      <a href={localePath(lang, '/profil')} class="btn btn-ghost shrink-0 px-6 py-3 text-sm max-sm:!border-0 max-sm:!bg-transparent max-sm:!p-2 max-sm:text-accent-fg max-sm:!shadow-none max-sm:after:absolute max-sm:after:inset-0 max-sm:after:rounded-2xl" data-umami-event="profil-home">
        <span class="max-sm:sr-only">{h.profileCta}</span> <ArrowRight class="size-5 sm:size-4" aria-hidden="true" />
      </a>
    </div>
    </div>
  </div>
</section>

<DiceWizard />

<style is:global>
  /* Verbe « tableau d'aéroport » : le mot entier roule vers le haut, le suivant monte du bas. */
  .flip-col { display: block; transition: transform .6s cubic-bezier(.7, 0, .2, 1); }
  .flip-word { display: block; height: 1.3em; line-height: 1.3; white-space: nowrap; }
</style>

<script>
  import { createDie } from '../../lib/die';

  // Textes de la langue courante, posés par le serveur (voir `src/i18n/`).
  const T = JSON.parse(document.getElementById('accueil')?.dataset.i18n ?? '{}') as {
    verbs: string[]; pauseLabel: string; resumeLabel: string; pauseTip: string; pausedTip: string; dieStatus: string;
  };
  // Un 20 donne toujours le premier verbe (D-12). 2ᵉ = offre outil, 3ᵉ = offre site (D-39).
  const VERBS = T.verbs;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-die]');
  const button = document.querySelector<HTMLButtonElement>('[data-die-btn]');
  const verb = document.querySelector<HTMLElement>('[data-verb]');
  const headline = verb?.closest('h1');
  const status = document.querySelector<HTMLElement>('[data-die-status]');

  if (canvas && button && verb) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 600;
    let current = verb.textContent ?? VERBS[0];
    let swapping = false;

    // Tableau d'affichage : le mot entier roule (l'ancien sort par le haut, le nouveau monte du bas).
    // Avec « mouvement réduit », le verbe change sans animation (le texte qui change n'est pas un mouvement).
    function setVerb(next: string) {
      if (swapping || next === current) return;
      if (reduced) { verb!.textContent = current = next; return; }
      swapping = true;
      const col = document.createElement('span');
      col.className = 'flip-col';
      for (const word of [current, next]) {
        const w = document.createElement('span');
        w.className = 'flip-word';
        w.textContent = word;
        col.append(w);
      }
      verb!.textContent = '';
      verb!.append(col);
      void verb!.offsetWidth; // force le calcul du style avant de lancer la transition
      col.style.transform = 'translateY(-50%)';
      setTimeout(() => {
        verb!.textContent = current = next;
        swapping = false;
      }, DURATION + 60);
    }

    // Rotation automatique : un verbe toutes les 4 s, pendant 5 tours complets (≈ 100 s), puis arrêt.
    // En pause tant que la souris est sur le titre. (Pas de test « onglet masqué » : certains navigateurs intégrés se déclarent masqués à tort et la rotation ne partait jamais.)
    let paused = false;
    let userPaused = false;
    let ticks = 0;
    const MAX_TICKS = VERBS.length * 5;
    const timer = setInterval(() => {
      if (ticks >= MAX_TICKS) return clearInterval(timer);
      if (paused || userPaused || swapping) return;
      ticks++;
      setVerb(VERBS[(VERBS.indexOf(current) + 1) % VERBS.length]);
    }, 4000);
    headline?.addEventListener('pointerenter', () => (paused = true));
    headline?.addEventListener('pointerleave', () => (paused = false));
    // Clavier : la rotation se met en pause tant que le bouton du dé a le focus (RGAA 13.8).
    button.addEventListener('focus', () => (paused = true));
    button.addEventListener('blur', () => (paused = false));

    const pauseBtn = document.querySelector<HTMLButtonElement>('[data-verb-pause]');
    // Le bouton se cale juste après « entreprises. » (hors flux : aucun décalage de mise en page). Mesure relative au titre :
    // l'animation d'apparition le déplace, mais le bouton et le texte bougent ensemble.
    const placePause = () => {
      const end = document.querySelector('[data-title-end]');
      if (!end || !headline || !pauseBtn) return;
      const range = document.createRange();
      range.selectNodeContents(end);
      const rects = range.getClientRects();
      const last = rects[rects.length - 1];
      if (!last) return;
      const h = headline.getBoundingClientRect();
      pauseBtn.style.left = `${last.right - h.left + 6}px`;
      pauseBtn.style.top = `${last.top - h.top + (last.height - pauseBtn.offsetHeight) / 2}px`;
    };
    placePause();
    new ResizeObserver(placePause).observe(headline ?? document.documentElement);
    document.fonts?.ready.then(placePause);
    const tip = pauseBtn?.querySelector<HTMLElement>('[data-verb-pause-tip]');
    let tipTimer: ReturnType<typeof setTimeout>;
    pauseBtn?.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      pauseBtn.querySelector('[data-icon-pause]')?.classList.toggle('hidden', userPaused);
      pauseBtn.querySelector('[data-icon-play]')?.classList.toggle('hidden', !userPaused);
      const text = userPaused ? T.resumeLabel : T.pauseLabel;
      pauseBtn.querySelector('[data-verb-pause-label]')!.textContent = text;
      if (tip) {
        // L'infobulle confirme le nouvel état un instant (utile au toucher, où il n'y a pas de survol).
        tip.textContent = userPaused ? T.pausedTip : T.pauseTip;
        tip.setAttribute('data-show', '');
        clearTimeout(tipTimer);
        tipTimer = setTimeout(() => tip.removeAttribute('data-show'), 2500);
      }
    });

    // Le dé n'existe que là où il est affiché (cartes côte à côte, dès 768 px, D-119) : sur téléphone, aucun dessin ni lancer.
    const wide = matchMedia('(min-width: 768px)');
    let die: ReturnType<typeof createDie> | undefined;
    let manualRoll = false;
    const ensureDie = () => {
      if (die || !wide.matches) return;
      die = createDie(canvas, {
        reducedMotion: reduced,
        onResult(value) {
          const manual = manualRoll;
          manualRoll = false;
          let next = value === 20 ? VERBS[0] : VERBS[value % VERBS.length];
          if (next === current) next = VERBS[(VERBS.indexOf(next) + 1) % VERBS.length];
          setVerb(next);
          if (status) status.textContent = T.dieStatus.replace('{value}', String(value)).replace('{verb}', next);
          // Défi du dé (D-130) : seuls les lancers du visiteur comptent ; DiceWizard.astro écoute cet événement.
          if (manual) document.dispatchEvent(new CustomEvent('die:result', { detail: { value } }));
        },
      });
      if (!reduced) setTimeout(() => die?.roll(), 900);
    };
    ensureDie();
    wide.addEventListener('change', ensureDie);

    // Lancer du visiteur : un clic sur le dé, ou la demande du wizard (événement `die:roll`).
    const roll = () => {
      if (!die) return;
      ticks = MAX_TICKS; // l'utilisateur prend la main : la rotation automatique s'arrête
      manualRoll = true;
      document.dispatchEvent(new CustomEvent('die:rolling'));
      die.roll();
      (window as any).umami?.track('die-roll');
    };
    button.addEventListener('click', roll);
    document.addEventListener('die:roll', roll);
  }
</script>
