---
import { X } from '@lucide/astro';
import { useI18n, localePath } from '../../i18n';

const { lang, t } = useI18n(Astro.url);
const w = t.hero.wizard;

// Textes du script : lus depuis l'attribut data-i18n (aucun texte en dur dans le script, D-110).
const texts = { ...w, contactHref: localePath(lang, '/#contact'), chariotHref: localePath(lang, '/realisations/chariot') };
---

{/* Défi du dé (D-130) : tablette et bureau, comme le dé. Le seul dé est celui posé entre les deux cartes (Hero.astro) :
    ce composant l'écoute (`die:result`, `die:rolling`), lui demande de rouler (`die:roll`) et joue les animations de résultat autour de lui. */}
<div data-screen-fx aria-hidden="true" class="screen-fx hidden md:block"></div>

<div data-wizard-root data-i18n={JSON.stringify(texts)} class="pointer-events-none fixed inset-x-0 bottom-0 z-50 hidden justify-center px-[var(--gutter)] pb-[max(1rem,env(safe-area-inset-bottom))] md:flex">
  <div
    id="de-wizard"
    data-wizard
    data-state="invite"
    role="dialog"
    aria-labelledby="de-wizard-title"
    aria-describedby="de-wizard-text"
    hidden
    class="wiz pointer-events-auto relative w-full max-w-xl rounded-card border border-line-strong bg-surface-2 p-5 shadow-[0_30px_60px_-24px_rgb(0_0_0/0.7)] lg:p-6"
  >
    <button type="button" data-wiz-close aria-label={w.closeLabel} class="absolute top-3 right-3 z-20 grid size-8 place-items-center rounded-full text-muted transition before:absolute before:-inset-1 before:content-[''] hover:text-ink">
      <X class="size-5" aria-hidden="true" />
    </button>

    <div class="min-w-0 pr-8" aria-live="polite">
      <p data-wiz-in style="--i:0" class="eyebrow" data-wiz-eyebrow>{w.invite.eyebrow}</p>
      <h2 data-wiz-in style="--i:1" id="de-wizard-title" class="mt-1.5 font-heading text-xl leading-tight font-semibold lg:text-2xl" data-wiz-title>{w.invite.title}</h2>
      <p data-wiz-in style="--i:2" id="de-wizard-text" class="mt-1.5 text-[15px] leading-snug lg:text-base" data-wiz-text>{w.invite.text}</p>
      <div data-wiz-in style="--i:3" class="mt-4 flex min-h-11 flex-wrap items-center gap-3">
        <button type="button" data-wiz-roll class="btn btn-primary !px-5 !py-2.5">{w.roll}</button>
        <a href={texts.chariotHref} data-wiz-chariot hidden class="btn btn-primary !px-5 !py-2.5" data-umami-event="de-chariot">{w.chariot}</a>
        <a href={texts.contactHref} data-wiz-contact hidden class="btn btn-primary !px-5 !py-2.5" data-umami-event="de-contact">{w.contact}</a>
        <button type="button" data-wiz-later class="btn btn-ghost !px-5 !py-2.5">{w.later}</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ── Entrée du wizard : montée + fondu + léger zoom (comme les cartes d'offre), puis cascade du contenu. ── */
  .wiz {
    opacity: 0;
    transform: translate3d(0, 56px, 0) scale(0.94);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wiz[data-open] { opacity: 1; transform: none; }

  .wiz.wiz-swap [data-wiz-in] { animation: wiz-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(0.12s + var(--i, 0) * 80ms); }
  .wiz.wiz-swap [data-wiz-title] { animation-name: wiz-title; }
  @keyframes wiz-in { from { opacity: 0; transform: translate3d(0, 14px, 0); } }
  @keyframes wiz-title { from { opacity: 0; transform: translate3d(0, 18px, 0); filter: blur(8px); } }

  /* ── Particules : triangles en fil de fer (les faces du d20) et anneaux, lancés depuis le dé. Pas de dégradé. ── */
  .wiz-p { position: absolute; width: var(--s, 14px); height: var(--s, 14px); margin: calc(var(--s, 14px) / -2) 0 0 calc(var(--s, 14px) / -2); color: var(--c, var(--c-accent-fg)); animation: wiz-fly var(--d, 1.2s) cubic-bezier(0.16, 0.8, 0.3, 1) var(--w, 0s) both; will-change: transform, opacity; }
  .wiz-p svg { display: block; width: 100%; height: 100%; overflow: visible; fill: none; stroke: currentColor; stroke-width: 3.4; stroke-linejoin: round; }
  @keyframes wiz-fly {
    0% { opacity: 0; transform: translate3d(0, 0, 0) scale(0.3) rotate(0deg); }
    12% { opacity: 1; }
    100% { opacity: 0; transform: translate3d(var(--x), var(--y), 0) scale(1) rotate(var(--r)); }
  }
  .wiz-ring { position: absolute; left: 50%; top: 50%; width: 88px; height: 88px; margin: -44px 0 0 -44px; border: 2px solid var(--c-accent-fg); border-radius: 9999px; animation: wiz-ring 1.1s cubic-bezier(0.16, 0.8, 0.3, 1) var(--w, 0s) both; }
  @keyframes wiz-ring { from { opacity: 1; transform: scale(0.3); } to { opacity: 0; transform: scale(var(--k, 3.2)); } }

  /* ── Le dé lui-même : chaque résultat a son mouvement (le rebond « pop » et l'atterrissage de l'écran de chargement). ── */
  .die-fx-crit { animation: die-crit 1.2s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes die-crit { 0% { transform: none; } 22% { transform: scale(1.4) rotate(-16deg); } 50% { transform: scale(0.94) rotate(9deg); } 75% { transform: scale(1.1) rotate(-3deg); } 100% { transform: none; } }
  .die-fx-win { animation: die-win 0.9s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes die-win { 0% { transform: none; } 35% { transform: translateY(-18px) scale(1.12); } 70% { transform: translateY(0) scale(1.05); } 100% { transform: none; } }
  .die-fx-lose { animation: die-lose 1.1s cubic-bezier(0.3, 0, 0.3, 1); }
  @keyframes die-lose { 0% { transform: none; } 35% { transform: translateY(9px) rotate(-14deg) scale(0.96); } 100% { transform: none; } }
  .die-fx-fail { animation: die-fail 1.4s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
  @keyframes die-fail {
    0%, 100% { transform: none; } 8% { transform: translate3d(-4px, 0, 0); } 16% { transform: translate3d(7px, 0, 0); } 24% { transform: translate3d(-9px, 0, 0); }
    32% { transform: translate3d(9px, 0, 0); } 40% { transform: translate3d(-5px, 0, 0); } 55%, 70% { transform: translateY(10px) rotate(-26deg) scale(0.88); }
  }

  /* ── Les cartes d'offre réagissent au résultat (zone `data-die-stage`). ── */
  .stage-crit > article { animation: stage-cheer 1.2s cubic-bezier(0.16, 1, 0.3, 1); outline: 3px solid transparent; outline-offset: 5px; }
  @keyframes stage-cheer { 0% { transform: none; } 28% { transform: translateY(-12px) scale(1.012); outline-color: var(--c-accent-fg); } 100% { transform: none; outline-color: transparent; } }
  .stage-win > article { animation: stage-nod 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes stage-nod { 0% { transform: none; } 30% { transform: translateY(-6px); } 100% { transform: none; } }
  .stage-lose > article { animation: stage-sag 1s cubic-bezier(0.3, 0, 0.3, 1); }
  @keyframes stage-sag { 0% { transform: none; } 35% { transform: translateY(5px); } 100% { transform: none; } }
  .stage-fail { animation: wiz-shake 0.7s cubic-bezier(0.36, 0.07, 0.19, 0.97); }

  /* ── Cadre d'écran : un trait d'accent qui s'allume sur un 20, un cadre sombre qui clignote sur un 1. ── */
  .screen-fx { position: fixed; inset: 0; z-index: 40; pointer-events: none; }
  .screen-crit { animation: screen-crit 1.6s ease-out; }
  @keyframes screen-crit { 0% { box-shadow: inset 0 0 0 0 var(--c-accent-fg); } 10% { box-shadow: inset 0 0 0 8px var(--c-accent-fg); } 100% { box-shadow: inset 0 0 0 0 var(--c-accent-fg); } }
  .screen-win { animation: screen-win 1s ease-out; }
  @keyframes screen-win { 0% { box-shadow: inset 0 0 0 0 var(--c-accent-fg); } 12% { box-shadow: inset 0 0 0 4px var(--c-accent-fg); } 100% { box-shadow: inset 0 0 0 0 var(--c-accent-fg); } }
  .screen-fail { animation: screen-fail 1s steps(1, end); }
  @keyframes screen-fail { 0%, 30%, 60%, 100% { box-shadow: none; } 10%, 40% { box-shadow: inset 0 0 0 8px var(--c-ink); } }

  /* ── Étiquette du résultat d'un lancer direct (wizard fermé) : pop avec léger flou, puis disparition. ── */
  .die-label.is-in { animation: die-label 2.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes die-label {
    0% { opacity: 0; transform: translate3d(-50%, 12px, 0) scale(0.8); filter: blur(6px); }
    12% { opacity: 1; transform: translate3d(-50%, 0, 0) scale(1); filter: none; }
    85% { opacity: 1; transform: translate3d(-50%, 0, 0) scale(1); }
    100% { opacity: 0; transform: translate3d(-50%, -6px, 0) scale(1); }
  }

  /* ── Carte du wizard : même vocabulaire que le dé. ── */
  .wiz.wiz-fx-crit { animation: wiz-crit 1.3s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes wiz-crit {
    0% { box-shadow: 0 0 0 0 var(--c-accent-fg); transform: scale(1); }
    18% { box-shadow: 0 0 0 10px transparent; transform: scale(1.035); border-color: var(--c-accent-fg); }
    100% { box-shadow: 0 0 0 28px transparent; transform: scale(1); }
  }
  .wiz.wiz-fx-win { animation: wiz-win 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes wiz-win { 0% { transform: scale(1); } 25% { transform: scale(1.02) translateY(-4px); border-color: var(--c-accent-fg); } 100% { transform: none; } }
  .wiz.wiz-fx-lose { animation: wiz-lose 1s cubic-bezier(0.3, 0, 0.3, 1); }
  @keyframes wiz-lose { 0% { transform: none; } 30% { transform: translateY(6px) rotate(-0.6deg); } 100% { transform: none; } }
  .wiz.wiz-fx-fail { animation: wiz-shake 0.7s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
  @keyframes wiz-shake {
    10%, 90% { transform: translate3d(-3px, 0, 0); } 20%, 80% { transform: translate3d(6px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-10px, 0, 0); } 40%, 60% { transform: translate3d(10px, 0, 0); }
  }

  /* Rappel discret sur le « ? » : l'anneau de l'accent pulse trois fois après l'apparition du dé. */
  .wiz-hint::after { content: ""; position: absolute; inset: 0; border-radius: 9999px; border: 2px solid var(--c-accent-fg); opacity: 0; animation: wiz-hint 2.4s ease-out 4s 3; pointer-events: none; }
  @keyframes wiz-hint { 0% { opacity: 0.9; transform: scale(1); } 100% { opacity: 0; transform: scale(2.6); } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-wizard-root]');
  const card = root?.querySelector<HTMLElement>('[data-wizard]');
  const opener = document.querySelector<HTMLButtonElement>('[data-wizard-open]');
  const dieBtn = document.querySelector<HTMLElement>('[data-die-btn]');
  const stage = document.querySelector<HTMLElement>('[data-die-stage]');
  const fx = document.querySelector<HTMLElement>('[data-die-fx]');
  const label = document.querySelector<HTMLElement>('[data-die-label]');
  const screenFx = document.querySelector<HTMLElement>('[data-screen-fx]');

  if (root && card && opener && dieBtn && stage && fx && label && screenFx) {
    type Copy = { eyebrow?: string; title: string; text: string };
    type State = 'invite' | 'rolling' | 'crit' | 'win' | 'lose' | 'fail';
    const T = JSON.parse(root.dataset.i18n ?? '{}') as {
      result: string; roll: string; again: string; later: string; close: string;
      invite: Copy; rolling: Copy; crit: Copy; win: Copy; lose: Copy; fail: Copy;
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = <E extends HTMLElement>(s: string) => card.querySelector<E>(s)!;
    const eyebrow = $('[data-wiz-eyebrow]'), title = $('[data-wiz-title]'), text = $('[data-wiz-text]');
    const btnRoll = $<HTMLButtonElement>('[data-wiz-roll]'), btnLater = $<HTMLButtonElement>('[data-wiz-later]');
    const linkContact = $<HTMLAnchorElement>('[data-wiz-contact]'), linkChariot = $<HTMLAnchorElement>('[data-wiz-chariot]'), btnClose = $<HTMLButtonElement>('[data-wiz-close]');

    let isOpen = false;
    const rnd = (a: number, b: number) => a + Math.random() * (b - a);

    // ── Wizard : texte (avec la cascade d'apparition) et boutons selon l'état. ──
    function show(state: State, value?: number) {
      card!.dataset.state = state;
      const c = T[state];
      eyebrow.textContent = c.eyebrow ?? T.result.replace('{n}', String(value ?? ''));
      title.textContent = c.title;
      text.textContent = c.text;
      const won = state === 'crit' || state === 'win';
      const result = state !== 'invite' && state !== 'rolling';
      btnRoll.hidden = state === 'rolling';
      btnRoll.textContent = result ? T.again : T.roll;
      btnRoll.className = won ? 'btn btn-ghost !px-5 !py-2.5' : 'btn btn-primary !px-5 !py-2.5';
      linkContact.hidden = state !== 'win';
      linkChariot.hidden = state !== 'crit';
      btnLater.hidden = state === 'rolling';
      btnLater.textContent = result ? T.close : T.later;
      card!.classList.remove('wiz-swap');
      void card!.offsetWidth;
      card!.classList.add('wiz-swap');
    }

    // ── Effets : triangles en fil de fer (les faces du d20) et anneaux, lancés depuis le centre du dé. ──
    const NS = 'http://www.w3.org/2000/svg';
    function burst(o: { n: number; from: number; to: number; min: number; max: number; size: [number, number]; colors: string[]; dur: [number, number]; drop?: number }) {
      const ox = fx!.clientWidth / 2, oy = fx!.clientHeight / 2;
      for (let i = 0; i < o.n; i++) {
        const a = (rnd(o.from, o.to) * Math.PI) / 180, d = rnd(o.min, o.max);
        const p = document.createElement('span');
        p.className = 'wiz-p';
        p.style.left = `${ox}px`; p.style.top = `${oy}px`;
        p.style.setProperty('--x', `${Math.cos(a) * d}px`);
        p.style.setProperty('--y', `${Math.sin(a) * d + (o.drop ?? 0)}px`);
        p.style.setProperty('--r', `${rnd(-300, 300)}deg`);
        p.style.setProperty('--s', `${rnd(...o.size)}px`);
        p.style.setProperty('--d', `${rnd(...o.dur)}s`);
        p.style.setProperty('--w', `${rnd(0, 0.18)}s`);
        p.style.setProperty('--c', o.colors[i % o.colors.length]);
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', '0 0 20 20');
        const tri = document.createElementNS(NS, 'polygon');
        tri.setAttribute('points', '10,2 18,17 2,17');
        svg.append(tri); p.append(svg); fx!.append(p);
        p.addEventListener('animationend', () => p.remove());
      }
    }
    function ring(delay: number, scale = 3.2) {
      const r = document.createElement('span');
      r.className = 'wiz-ring';
      r.style.setProperty('--w', `${delay}s`); r.style.setProperty('--k', String(scale));
      fx!.append(r);
      r.addEventListener('animationend', () => r.remove());
    }
    const ACCENT = 'var(--c-accent-fg)', INK = 'var(--c-ink)', MUTED = 'var(--c-muted)';
    const stateOf = (v: number): State => (v === 20 ? 'crit' : v >= 10 ? 'win' : v === 1 ? 'fail' : 'lose');
    const CARD_FX = ['wiz-fx-crit', 'wiz-fx-win', 'wiz-fx-lose', 'wiz-fx-fail'];
    const DIE_FX = ['die-fx-crit', 'die-fx-win', 'die-fx-lose', 'die-fx-fail'];
    const STAGE_FX = ['stage-crit', 'stage-win', 'stage-lose', 'stage-fail'];
    const SCREEN_FX = ['screen-crit', 'screen-win', 'screen-lose', 'screen-fail'];
    let fxTimer: ReturnType<typeof setTimeout>;

    function clearFx() {
      clearTimeout(fxTimer);
      card!.classList.remove(...CARD_FX);
      dieBtn!.classList.remove(...DIE_FX);
      stage!.classList.remove(...STAGE_FX);
      screenFx!.classList.remove(...SCREEN_FX);
    }

    // 20 : le dé bondit, trois anneaux, deux salves de triangles, les cartes se redressent, cadre d'accent.
    // 10-19 : saut du dé, un anneau, une gerbe, les cartes hochent. 2-9 : le dé s'affaisse, quelques triangles retombent.
    // 1 : le dé tremble puis tombe, triangles lourds, tout l'écran tremble et le cadre clignote.
    function play(state: State) {
      clearFx();
      if (reduced) return;
      void stage!.offsetWidth;
      const k = state;
      card!.classList.add(`wiz-fx-${k}`); dieBtn!.classList.add(`die-fx-${k}`); stage!.classList.add(`stage-${k}`); screenFx!.classList.add(`screen-${k}`);
      if (k === 'crit') {
        ring(0); ring(0.14, 4.6); ring(0.28, 6.2);
        burst({ n: 34, from: 0, to: 360, min: 140, max: 340, size: [13, 26], colors: [ACCENT, INK, ACCENT], dur: [1, 1.7] });
        burst({ n: 20, from: -160, to: -20, min: 240, max: 460, size: [12, 20], colors: [ACCENT, INK], dur: [1.5, 2.2], drop: 160 });
      } else if (k === 'win') {
        ring(0, 3);
        burst({ n: 16, from: 0, to: 360, min: 80, max: 200, size: [12, 20], colors: [ACCENT, INK], dur: [0.9, 1.4] });
      } else if (k === 'lose') {
        burst({ n: 9, from: 50, to: 130, min: 50, max: 130, size: [10, 15], colors: [MUTED], dur: [1.3, 1.9], drop: 50 });
      } else if (k === 'fail') {
        burst({ n: 20, from: 30, to: 150, min: 100, max: 260, size: [13, 22], colors: [INK, MUTED], dur: [1, 1.7], drop: 130 });
      }
      fxTimer = setTimeout(clearFx, 2000);
    }

    // Étiquette posée sur le dé quand le wizard est fermé (lancer direct).
    function showLabel(textContent: string) {
      label!.textContent = textContent;
      label!.hidden = false;
      label!.classList.remove('is-in');
      void label!.offsetWidth;
      label!.classList.add('is-in');
    }
    label.addEventListener('animationend', () => { label.hidden = true; label.classList.remove('is-in'); });

    // ── Le dé du hero (Hero.astro) : on écoute ses lancers, on ne le recrée pas. ──
    document.addEventListener('die:rolling', () => {
      clearFx();
      label.hidden = true;
      if (isOpen) show('rolling');
    });
    document.addEventListener('die:result', (e) => {
      const value = (e as CustomEvent<{ value: number }>).detail.value;
      const state = stateOf(value);
      if (isOpen) show(state, value);
      else if (state === 'crit') setTimeout(() => open('crit', value), reduced ? 0 : 900); // un 20 sans le wizard : il s'ouvre pour proposer Chariot, une fois l'animation vue
      else showLabel(`${value} · ${T[state].title}`);
      play(state);
      (window as any).umami?.track(state === 'crit' || state === 'win' ? 'de-gagne' : 'de-perdu');
    });

    // Le wizard est posé en bas de l'écran : si le dé est caché derrière lui (ou hors écran), on fait défiler pour le garder en vue.
    function keepDieVisible() {
      const d = dieBtn!.getBoundingClientRect();
      const top = innerHeight - card!.offsetHeight - 24, header = 72;
      if (d.bottom < top - 12 && d.top > header) return;
      const delta = d.top + d.height / 2 - (header + top) / 2;
      scrollBy({ top: delta, behavior: reduced ? 'auto' : 'smooth' });
    }

    function open(state: State = 'invite', value?: number) {
      if (isOpen) return;
      isOpen = true;
      opener!.setAttribute('aria-expanded', 'true');
      show(state, value);
      card!.hidden = false;
      void card!.offsetWidth;
      card!.setAttribute('data-open', '');
      keepDieVisible();
      setTimeout(() => (state === 'crit' ? linkChariot : btnRoll).focus({ preventScroll: true }), reduced ? 0 : 350);
      (window as any).umami?.track('de-ouvrir');
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      opener!.setAttribute('aria-expanded', 'false');
      card!.removeAttribute('data-open');
      clearFx();
      setTimeout(() => { if (!isOpen) card!.hidden = true; }, reduced ? 0 : 700);
      opener!.focus({ preventScroll: true });
    }

    opener.addEventListener('click', () => (isOpen ? close() : open()));
    btnRoll.addEventListener('click', () => document.dispatchEvent(new CustomEvent('die:roll')));
    btnLater.addEventListener('click', close);
    btnClose.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) close(); });
  }
</script>
