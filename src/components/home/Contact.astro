---
import { site } from '../../config/site';

---

<section id="contact" class="border-t border-line bg-surface pt-10 pb-20 sm:pt-14 sm:pb-24">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Parlons de votre projet.</h2>
      <p class="mt-5 max-w-md leading-relaxed text-muted">
        Décrivez votre besoin en quelques lignes, même s'il est encore flou. Je vous réponds sous 24 h ouvrées
        avec des premières pistes, sans engagement.
      </p>
      <dl class="mt-10 space-y-5 text-sm">
        <div>
          <dt class="text-muted">Email</dt>
          <dd class="mt-1 font-medium"><a class="hover:text-accent-fg" href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        {site.links.calendar && (
          <div>
            <dt class="text-muted">Vous préférez parler ?</dt>
            <dd class="mt-1">
              <a class="font-medium text-accent-fg" href={site.links.calendar} target="_blank" rel="noopener" data-umami-event="cta-calendar">
                Réserver un appel de 20 min →
              </a>
            </dd>
          </div>
        )}
        <div>
          <dt class="text-muted">Où</dt>
          <dd class="mt-1 font-medium">{site.location}</dd>
        </div>
      </dl>
    </div>

    <form
      id="contact-form"
      method="post"
      action="/api/contact"
      class="rounded-card border border-line bg-bg p-6 sm:p-9"
      novalidate
    >
      <fieldset>
        <legend class="text-sm font-semibold">Votre projet concerne</legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-3">
          {[
            { v: 'outil', l: 'Un outil sur mesure' },
            { v: 'site', l: 'Un site' },
            { v: 'autre', l: 'Autre' },
          ].map((o, i) => (
            <label class="cursor-pointer rounded-xl border border-line px-4 py-3 text-sm transition has-checked:border-accent has-checked:bg-accent-soft has-checked:font-medium">
              <input type="radio" name="projectType" value={o.v} class="sr-only" checked={i === 2} />
              {o.l}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <label class="block text-sm">
          <span class="font-medium">Nom <span class="text-accent-fg" aria-hidden="true">*</span></span>
          <input name="name" required autocomplete="name" maxlength="100" class="field" />
        </label>
        <label class="block text-sm">
          <span class="font-medium">Email <span class="text-accent-fg" aria-hidden="true">*</span></span>
          <input name="email" type="email" required autocomplete="email" maxlength="200" class="field" />
        </label>
        <label class="block text-sm">
          <span class="font-medium">Entreprise</span>
          <input name="company" autocomplete="organization" maxlength="120" class="field" />
        </label>
        <label class="block text-sm">
          <span class="font-medium">Budget indicatif</span>
          <select name="budget" class="field">
            <option value="">Je ne sais pas encore</option>
            <option>Moins de 2 000 €</option>
            <option>2 000 – 5 000 €</option>
            <option>5 000 – 15 000 €</option>
            <option>Plus de 15 000 €</option>
          </select>
        </label>
      </div>

      <label class="mt-5 block text-sm">
        <span class="font-medium">Votre besoin <span class="text-accent-fg" aria-hidden="true">*</span></span>
        <textarea name="message" required minlength="20" maxlength="5000" rows="5" class="field resize-y"
          placeholder="Ex. : je gère mes devis sur Excel et je perds du temps à relancer mes clients…"></textarea>
      </label>

      <!-- Anti-spam : champ piège invisible + horodatage -->
      <div class="hidden" aria-hidden="true">
        <label>Ne pas remplir <input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="startedAt" value="" />

      <p class="mt-5 text-[13px] leading-relaxed text-muted">
        Vos informations servent uniquement à répondre à votre demande. Elles ne sont ni stockées en base, ni transmises à des tiers.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button type="submit" class="btn btn-primary" data-umami-event="contact-submit">
          Envoyer ma demande
        </button>
        <p data-status role="status" aria-live="polite" class="text-sm"></p>
      </div>
    </form>
  </div>
</section>

<style>
  @reference "../../styles/global.css";
  .field {
    @apply mt-1.5 block w-full rounded-2xl border border-line-strong bg-bg px-4 py-3 text-base text-ink transition placeholder:text-muted focus:border-accent focus:outline-none sm:text-sm;
  }
  .field[aria-invalid='true'] {
    @apply border-accent;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const statusEl = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const setStatus = (text: string, ok: boolean) => {
      statusEl.textContent = text;
      statusEl.className = `text-sm ${ok ? 'text-ok-fg' : 'text-accent-fg'}`;
    };
    const SUCCESS = 'Merci, votre message est bien parti. Je vous réponds sous 24 h ouvrées.';
    (form.elements.namedItem('startedAt') as HTMLInputElement).value = String(Date.now());

    // Préselection depuis les cartes d'offre : /?projet=site#contact
    const params = new URLSearchParams(location.search);
    const preset = params.get('projet');
    if (preset) {
      const radio = form.querySelector<HTMLInputElement>(`input[name=projectType][value="${CSS.escape(preset)}"]`);
      if (radio) radio.checked = true;
    }
    // Retour du repli sans JS
    const envoi = params.get('envoi');
    if (envoi) {
      setStatus(envoi === 'ok' ? SUCCESS : 'Le message n’a pas pu être envoyé. Écrivez-moi directement par email.', envoi === 'ok');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((f) => {
        const ok = f.checkValidity();
        f.setAttribute('aria-invalid', String(!ok));
        if (!ok && valid) { f.focus(); valid = false; }
      });
      if (!valid) {
        setStatus('Merci de compléter les champs obligatoires (message : 20 caractères minimum).', false);
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Envoi…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? 'Erreur');
        form.reset();
        setStatus(SUCCESS, true);
        (window as any).umami?.track('contact-success');
      } catch (err) {
        setStatus((err as Error).message, false);
      } finally {
        submit.disabled = false;
        submit.textContent = 'Envoyer ma demande';
      }
    });
  }
</script>
