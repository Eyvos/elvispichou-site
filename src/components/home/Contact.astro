---
import { PenLine, MailCheck, Phone, Mail } from '@lucide/astro';
import { site } from '../../config/site';

const projectTypes = [
  { v: 'outil', l: 'Un outil sur mesure' },
  { v: 'site', l: 'Un site vitrine' },
  { v: 'autre', l: 'Autre' },
];

const budgets = [
  { v: '', l: 'Je ne sais pas encore' },
  { v: 'Moins de 2 000 €', l: 'Moins de 2 000 €' },
  { v: '2 000 – 5 000 €', l: '2 000 – 5 000 €' },
  { v: '5 000 – 15 000 €', l: '5 000 – 15 000 €' },
  { v: 'Plus de 15 000 €', l: 'Plus de 15 000 €' },
];

const steps = [
  { Icon: PenLine, title: 'Vous écrivez', text: 'Quelques lignes suffisent, même si le besoin est encore flou.' },
  { Icon: MailCheck, title: 'Je vous réponds sous 24 h ouvrées', text: 'Avec de premières pistes, sans engagement.' },
  { Icon: Phone, title: 'On en parle', text: 'De vive voix si vous le souhaitez, sinon par email.' },
];
---

<section id="contact" class="pt-10 pb-20 sm:pt-14 sm:pb-24">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.45fr] lg:gap-10">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Parlons de votre projet.</h2>
      <p class="mt-5 max-w-md leading-relaxed text-muted">
        Décrivez votre besoin en quelques lignes, même s'il est encore flou. Pas de jargon : on parle de votre activité, pas de technique.
      </p>

      <!-- Ce qui se passe après l'envoi : rassure les prospects qui n'ont jamais travaillé avec un freelance -->
      <ol class="mt-10">
        {steps.map(({ Icon, title, text }, i) => (
          <li class="relative flex gap-4 pb-8 last:pb-0">
            {i < steps.length - 1 && <span class="absolute top-12 bottom-1 left-[1.375rem] w-px bg-line-strong" aria-hidden="true"></span>}
            <span class="relative grid size-11 shrink-0 place-items-center rounded-2xl bg-accent-soft text-accent-fg">
              <Icon class="size-5" aria-hidden="true" />
            </span>
            <div class="pt-0.5">
              <p class="font-heading font-semibold">{title}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted">{text}</p>
            </div>
          </li>
        ))}
      </ol>

      <dl class="mt-10 space-y-5 border-t border-line pt-8 text-sm">
        <div>
          <dt class="text-muted">Vous préférez écrire directement ?</dt>
          <dd class="mt-2">
            <a class="btn btn-ghost" href={`mailto:${site.email}`} data-umami-event="cta-mailto">
              <Mail class="size-4" aria-hidden="true" />
              M'écrire par email
            </a>
          </dd>
        </div>
        {site.links.calendar && (
          <div>
            <dt class="text-muted">Vous préférez parler ?</dt>
            <dd class="mt-1">
              <a class="font-medium text-accent-fg" href={site.links.calendar} target="_blank" rel="noopener" data-umami-event="cta-calendar">
                Réserver un appel de 20 min <span aria-hidden="true">→</span><span class="sr-only"> (nouvelle fenêtre)</span>
              </a>
            </dd>
          </div>
        )}
      </dl>
    </div>

    <form
      id="contact-form"
      method="post"
      action="/api/contact"
      class="rounded-card border border-line bg-surface p-6 sm:p-9"
      novalidate
    >
      <p class="mb-6 text-sm text-muted">Les champs marqués d’un <span class="text-accent-fg">*</span> sont obligatoires.</p>

      <fieldset>
        <legend class="text-sm font-medium">Votre projet concerne</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {projectTypes.map((o, i) => (
            <label class="choice rounded-full border border-line px-4 py-2 text-sm">
              <input type="radio" name="projectType" value={o.v} class="sr-only" checked={i === 2} />
              {o.l}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-6">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-medium">Nom <span class="text-accent-fg" aria-hidden="true">*</span></span>
            <input name="name" required aria-describedby="err-name" autocomplete="name" maxlength="100" class="field" />
            <span id="err-name" data-err class="mt-1 block text-sm font-medium text-accent-fg"></span>
          </label>
          <label class="block text-sm">
            <span class="font-medium">Email <span class="text-accent-fg" aria-hidden="true">*</span></span>
            <input name="email" type="email" required aria-describedby="err-email" autocomplete="email" maxlength="200" class="field" />
            <span id="err-email" data-err class="mt-1 block text-sm font-medium text-accent-fg"></span>
          </label>
          <label class="block text-sm sm:col-span-2">
            <span class="font-medium">Entreprise</span>
            <input name="company" autocomplete="organization" maxlength="120" class="field" />
          </label>
        </div>
      </div>

      <div class="mt-5">
        <label class="block text-sm">
          <span class="font-medium">Votre besoin <span class="text-accent-fg" aria-hidden="true">*</span></span>
          <textarea name="message" required minlength="20" maxlength="5000" rows="6" aria-describedby="err-message" class="field min-h-40 resize-y"
            placeholder="Ex. : je gère mes devis sur Excel et je perds du temps à relancer mes clients…"></textarea>
          <span id="err-message" data-err class="mt-1 block text-sm font-medium text-accent-fg"></span>
        </label>

        <fieldset class="mt-5">
          <legend class="text-sm font-medium">Budget indicatif <span class="text-muted font-normal">(facultatif)</span></legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {budgets.map((b, i) => (
              <label class="choice rounded-full border border-line px-4 py-2 text-sm">
                <input type="radio" name="budget" value={b.v} class="sr-only" checked={i === 0} />
                {b.l}
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <!-- Anti-spam : champ piège invisible + horodatage -->
      <div class="hidden" aria-hidden="true">
        <label>Ne pas remplir <input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="startedAt" value="" />

      <p class="mt-7 text-[13px] leading-relaxed text-muted">
        Vos informations servent uniquement à répondre à votre demande. Elles ne sont ni vendues ni utilisées pour de la prospection ;
        détails et droits dans les <a class="underline hover:text-ink" href="/mentions-legales#donnees">mentions légales</a>.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button type="submit" class="btn btn-primary" data-umami-event="contact-submit">
          Envoyer ma demande
        </button>
        <p data-status role="status" aria-live="polite" class="text-sm"></p>
      </div>
    </form>
  </div>
</section>

<style>
  @reference "../../styles/global.css";
  .field {
    @apply mt-1.5 block w-full rounded-2xl border border-line-strong bg-bg px-4 py-3 text-base text-ink transition placeholder:text-muted focus:border-accent-fg sm:text-sm;
  }
  .field[aria-invalid='true'] {
    @apply border-accent;
  }
  /* Choix à pastilles (type de projet, budget) : remplace les menus du navigateur */
  .choice {
    @apply transition has-checked:border-accent has-checked:bg-accent-soft has-checked:font-medium has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent-fg hover:border-line-strong;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const statusEl = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const setStatus = (text: string, ok: boolean) => {
      statusEl.textContent = text;
      statusEl.className = `text-sm ${ok ? 'text-ok-fg' : 'text-accent-fg'}`;
    };
    const SUCCESS = 'Merci, votre message est bien parti. Je vous réponds sous 24 h ouvrées.';
    const FALLBACK = 'Le message n’a pas pu être envoyé. Réessayez dans un instant, ou écrivez-moi directement par email.';
    (form.elements.namedItem('startedAt') as HTMLInputElement).value = String(Date.now());

    // Préselection depuis les cartes d'offre : /?projet=site#contact
    const params = new URLSearchParams(location.search);
    const preset = params.get('projet');
    if (preset) {
      const radio = form.querySelector<HTMLInputElement>(`input[name=projectType][value="${CSS.escape(preset)}"]`);
      if (radio) radio.checked = true;
    }
    // Retour du repli sans JS
    const envoi = params.get('envoi');
    if (envoi) {
      setStatus(envoi === 'ok' ? SUCCESS : FALLBACK, envoi === 'ok');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((f) => {
        const ok = f.checkValidity();
        f.setAttribute('aria-invalid', String(!ok));
        const err = form.querySelector<HTMLElement>(`#err-${f.name}`);
        if (err) {
          err.textContent = ok ? '' : f.validity.valueMissing ? 'Ce champ est obligatoire.'
            : f.validity.typeMismatch ? 'Saisissez une adresse email valide, par exemple nom@exemple.fr.'
            : f.validity.tooShort ? 'Écrivez au moins 20 caractères.' : 'Valeur invalide.';
        }
        if (!ok && valid) { f.focus(); valid = false; }
      });
      if (!valid) {
        setStatus('Le formulaire contient des erreurs : corrigez les champs signalés.', false);
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Envoi…';
      try {
        // URL absolue sur l'origine courante : évite toute dépendance à <base> ou à un chemin relatif.
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        // Une réponse qui n'est pas du JSON (page d'erreur de l'hébergeur, 404…) ne doit pas afficher de message technique.
        const data = await res.json().catch(() => null);
        if (!res.ok || !data?.ok) throw new Error(data?.error ?? FALLBACK);
        form.reset();
        setStatus(SUCCESS, true);
        (window as any).umami?.track('contact-success');
      } catch (err) {
        // « Failed to fetch » (TypeError réseau) : message lisible plutôt que le texte du navigateur.
        setStatus(err instanceof TypeError ? FALLBACK : (err as Error).message, false);
      } finally {
        submit.disabled = false;
        submit.textContent = 'Envoyer ma demande';
      }
    });
  }
</script>
