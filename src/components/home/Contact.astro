---
import { PenLine, MailCheck, Phone, Mail } from '@lucide/astro';
import { site } from '../../config/site';
import { useI18n, localePath } from '../../i18n';

const { lang, t } = useI18n(Astro.url);
const c = t.contact;

const projectTypes = (['outil', 'site', 'autre'] as const).map((v) => ({ v, l: c.projectTypes[v] }));

// Valeurs envoyées : des codes indépendants de la langue (le serveur les traduit), jamais le libellé affiché.
const budgets = (['none', 'lt2k', '2to5k', '5to15k', 'gt15k'] as const).map((v) => ({ v: v === 'none' ? '' : v, l: c.budgets[v] }));

const steps = [PenLine, MailCheck, Phone].map((Icon, i) => ({ Icon, ...c.steps[i] }));

// Messages du script du formulaire.
const scriptTexts = { ...c.msg, sending: c.sending, submit: c.submit };
---

<section id="contact" class="pt-8 pb-12 sm:pt-14 sm:pb-24">
  {/* Téléphone et tablette : le formulaire vient juste après l'introduction (le visiteur qui touche « Contact » voit tout de suite un champ),
      la frise « ce qui se passe ensuite » et l'email après lui. Bureau : frise à gauche, formulaire à droite (D-87), inchangé (D-118). */}
  <div class="container-page grid gap-8 sm:gap-10 lg:grid-cols-[1fr_1.45fr] lg:grid-rows-[auto_1fr] lg:gap-x-10 lg:gap-y-0">
    <div class="lg:col-start-1 lg:row-start-1">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 class="section-title">{c.title}</h2>
      <p class="mt-5 max-w-md leading-relaxed text-muted">
        {c.intro}
      </p>
    </div>

    <form
      id="contact-form"
      method="post"
      action="/api/contact"
      class="rounded-card border border-line bg-surface p-4 min-[400px]:p-5 sm:p-9 lg:col-start-2 lg:row-span-2 lg:row-start-1"
      data-i18n={JSON.stringify(scriptTexts)}
      novalidate
    >
      <input type="hidden" name="lang" value={lang} />
      <p class="mb-6 text-sm text-muted">{c.requiredNote[0]}<span class="text-accent-fg">*</span>{c.requiredNote[1]}</p>

      <fieldset>
        <legend class="text-sm font-medium">{c.projectLegend}</legend>
        {/* Téléphone : les trois options sur une seule ligne, à parts égales (D-119). */}
        <div class="mt-2 grid grid-cols-3 gap-1.5 sm:flex sm:flex-wrap sm:gap-2">
          {projectTypes.map((o, i) => (
            <label class="choice inline-flex items-center justify-center rounded-full border border-line px-2 py-1.5 text-center text-[13px] leading-tight max-md:min-h-11 pointer-coarse:min-h-11 sm:px-4 sm:py-2 sm:text-sm">
              <input type="radio" name="projectType" value={o.v} class="sr-only" checked={i === 2} />
              {o.l}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-6">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-medium">{c.name} <span class="text-accent-fg" aria-hidden="true">*</span></span>
            <input name="name" required aria-describedby="err-name" autocomplete="name" autocapitalize="words" enterkeyhint="next" maxlength="100" class="field" />
            <span id="err-name" data-err class="mt-1 block text-sm font-medium text-accent-fg"></span>
          </label>
          <label class="block text-sm">
            <span class="font-medium">{c.email} <span class="text-accent-fg" aria-hidden="true">*</span></span>
            <input name="email" type="email" inputmode="email" required aria-describedby="err-email" autocomplete="email" autocapitalize="off" spellcheck="false" enterkeyhint="next" maxlength="200" class="field" />
            <span id="err-email" data-err class="mt-1 block text-sm font-medium text-accent-fg"></span>
          </label>
          <label class="block text-sm sm:col-span-2">
            <span class="font-medium">{c.company}</span>
            <input name="company" autocomplete="organization" autocapitalize="words" enterkeyhint="next" maxlength="120" class="field" />
          </label>
        </div>
      </div>

      <div class="mt-5">
        <label class="block text-sm">
          <span class="font-medium">{c.message} <span class="text-accent-fg" aria-hidden="true">*</span></span>
          <textarea name="message" required minlength="20" maxlength="5000" rows="6" aria-describedby="err-message" class="field min-h-40 resize-y"
            placeholder={c.placeholder}></textarea>
          <span id="err-message" data-err class="mt-1 block text-sm font-medium text-accent-fg"></span>
        </label>

        <fieldset class="mt-5">
          <legend class="text-sm font-medium">{c.budgetLegend} <span class="text-muted font-normal">{c.optional}</span></legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {budgets.map((b, i) => (
              <label class="choice inline-flex items-center rounded-full max-md:min-h-11 pointer-coarse:min-h-11 border border-line px-4 py-2 text-sm">
                <input type="radio" name="budget" value={b.v} class="sr-only" checked={i === 0} />
                {b.l}
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <!-- Anti-spam : champ piège invisible + horodatage -->
      <div class="hidden" aria-hidden="true">
        <label>{c.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="startedAt" value="" />

      <p class="mt-7 text-[13px] leading-relaxed text-muted">
        {c.privacy[0]}<a class="underline hover:text-ink" href={localePath(lang, '/mentions-legales#donnees')}>{c.privacy[1]}</a>{c.privacy[2]}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button type="submit" class="btn btn-primary max-sm:w-full max-sm:!py-3.5 max-sm:!text-base" data-umami-event="contact-submit">
          {c.submit}
        </button>
        <p data-status role="status" aria-live="polite" class="text-sm"></p>
      </div>
    </form>

    <div class="lg:col-start-1 lg:row-start-2">
      <!-- Ce qui se passe après l'envoi : rassure les prospects qui n'ont jamais travaillé avec un freelance. Tablette : trois colonnes. -->
      <ol class="md:max-lg:grid md:max-lg:grid-cols-3 md:max-lg:gap-6 lg:mt-10">
        {steps.map(({ Icon, title, text }, i) => (
          <li class="relative flex gap-4 pb-6 last:pb-0 sm:pb-8 md:max-lg:pb-0">
            {i < steps.length - 1 && <span class="absolute top-12 bottom-1 left-[1.375rem] w-px bg-line-strong md:max-lg:hidden" aria-hidden="true"></span>}
            <span class="relative grid size-11 shrink-0 place-items-center rounded-2xl bg-accent-soft text-accent-fg">
              <Icon class="size-5" aria-hidden="true" />
            </span>
            <div class="pt-0.5">
              <p class="font-heading font-semibold">{title}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted">{text}</p>
            </div>
          </li>
        ))}
      </ol>

      <dl class="mt-8 space-y-5 border-t border-line pt-6 text-sm sm:mt-10 sm:pt-8">
        <div>
          <dt class="text-muted">{c.preferWriting}</dt>
          <dd class="mt-2">
            <a class="btn btn-ghost" href={`mailto:${site.email}`} data-umami-event="cta-mailto">
              <Mail class="size-4" aria-hidden="true" />
              {c.writeByEmail}
            </a>
          </dd>
        </div>
        {site.links.calendar && (
          <div>
            <dt class="text-muted">{c.preferTalking}</dt>
            <dd class="mt-1">
              <a class="font-medium text-accent-fg" href={site.links.calendar} target="_blank" rel="noopener" data-umami-event="cta-calendar">
                {c.bookCall} <span aria-hidden="true">→</span><span class="sr-only">{t.common.newWindow}</span>
              </a>
            </dd>
          </div>
        )}
      </dl>
    </div>

  </div>
</section>

<style>
  @reference "../../styles/global.css";
  .field {
    @apply mt-1.5 block w-full rounded-2xl border border-line-strong bg-bg px-4 py-3 text-base text-ink transition placeholder:text-muted focus:border-accent-fg sm:text-sm pointer-coarse:text-base;
  }
  .field[aria-invalid='true'] {
    @apply border-accent;
  }
  /* Choix à pastilles (type de projet, budget) : remplace les menus du navigateur */
  .choice {
    @apply transition has-checked:border-accent has-checked:bg-accent-soft has-checked:font-medium has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent-fg hover:border-line-strong;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const statusEl = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const setStatus = (text: string, ok: boolean, reveal = true) => {
      statusEl.textContent = text;
      statusEl.className = `text-sm ${ok ? 'text-ok-fg' : 'text-accent-fg'}`;
      // Téléphone : le message peut être sous le clavier ou hors écran, on le ramène à la vue.
      if (reveal) statusEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };
    // Textes de la langue courante, posés par le serveur (voir `src/i18n/`).
    const T = JSON.parse(form.dataset.i18n ?? '{}') as Record<string, string>;
    const SUCCESS = T.success;
    const FALLBACK = T.fallback;
    (form.elements.namedItem('startedAt') as HTMLInputElement).value = String(Date.now());

    // Préselection depuis les cartes d'offre : /?projet=site#contact
    const params = new URLSearchParams(location.search);
    const preset = params.get('projet');
    if (preset) {
      const radio = form.querySelector<HTMLInputElement>(`input[name=projectType][value="${CSS.escape(preset)}"]`);
      if (radio) radio.checked = true;
    }
    // Retour du repli sans JS
    const envoi = params.get('envoi');
    if (envoi) {
      setStatus(envoi === 'ok' ? SUCCESS : FALLBACK, envoi === 'ok');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((f) => {
        const ok = f.checkValidity();
        f.setAttribute('aria-invalid', String(!ok));
        const err = form.querySelector<HTMLElement>(`#err-${f.name}`);
        if (err) {
          err.textContent = ok ? '' : f.validity.valueMissing ? T.required
            : f.validity.typeMismatch ? T.emailInvalid
            : f.validity.tooShort ? T.tooShort : T.invalid;
        }
        if (!ok && valid) { f.focus(); valid = false; }
      });
      if (!valid) {
        setStatus(T.errors, false, false); // le focus est déjà sur le premier champ en erreur
        return;
      }

      submit.disabled = true;
      submit.textContent = T.sending;
      try {
        // URL absolue sur l'origine courante : évite toute dépendance à <base> ou à un chemin relatif.
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        // Une réponse qui n'est pas du JSON (page d'erreur de l'hébergeur, 404…) ne doit pas afficher de message technique.
        const data = await res.json().catch(() => null);
        if (!res.ok || !data?.ok) throw new Error(data?.error ?? FALLBACK);
        form.reset();
        setStatus(SUCCESS, true);
        (window as any).umami?.track('contact-success');
      } catch (err) {
        // « Failed to fetch » (TypeError réseau) : message lisible plutôt que le texte du navigateur.
        setStatus(err instanceof TypeError ? FALLBACK : (err as Error).message, false);
      } finally {
        submit.disabled = false;
        submit.textContent = T.submit;
      }
    });
  }
</script>
