---
import { Image } from 'astro:assets';
import { Search, UserRound, Wrench, MapPin } from '@lucide/astro';
import { site } from '../../config/site';
import { getPhoto } from '../../lib/assets';

const photo = getPhoto();

const stats = [
  { value: '2021', label: 'Je conçois des applications web' },
  { value: '4 ans', label: 'Au service de la Gendarmerie nationale' },
  { value: '3 000', label: 'Utilisateurs sur mes plus grosses applications' },
  { value: '1 SaaS', label: 'Cofondé : Chariot' },
];

const reasons = [
  { icon: Search, title: 'Je comprends votre métier avant de coder', text: 'Quatre ans à recueillir des besoins auprès d’utilisateurs de terrain : je pose les bonnes questions avant de proposer une solution.' },
  { icon: UserRound, title: 'Un seul interlocuteur, de A à Z', text: 'Conception, développement, mise en ligne et maintenance. Pas d’intermédiaire, pas de message perdu entre deux équipes.' },
  { icon: Wrench, title: 'Des outils faits pour durer', text: 'Des applications utilisées par des milliers de personnes et maintenues pendant des années : je construis pour que ça dure.' },
];
---

<section id="a-propos" class="pt-10 pb-20 sm:pt-14 sm:pb-24">
  <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,380px)_1fr] lg:gap-16">
    <div class="relative mx-auto w-full max-w-sm lg:sticky lg:top-24 lg:max-w-none lg:self-start">
      <div class="relative aspect-[4/5] overflow-hidden rounded-card border border-line bg-surface-2">
        {photo ? (
          <Image src={photo} alt="Elvis Pichou, développeur web freelance" widths={[400, 760]} sizes="(min-width: 1024px) 380px, 90vw" class="size-full object-cover" />
        ) : (
          // Sans photo : monogramme. En développement, un rappel de l'emplacement du fichier.
          <div class="grid size-full place-items-center">
            <span class="font-display text-7xl font-semibold text-accent-fg">EP</span>
            {import.meta.env.DEV && (
              <p class="absolute inset-x-6 bottom-6 rounded-2xl border border-dashed border-line-strong p-3 text-center text-[13px] text-muted">
                Photo : déposer <code>src/assets/elvis.jpg</code>
              </p>
            )}
          </div>
        )}
      </div>
      <p class="absolute -bottom-4 left-4 inline-flex items-center gap-2 rounded-full border border-line bg-bg px-4 py-2 text-[13px] font-bold">
        <MapPin class="size-4 text-accent-fg" aria-hidden="true" />{site.location}
      </p>
    </div>

    <div>
      <p class="eyebrow">Qui je suis</p>
      <h2 class="section-title max-w-2xl">Un développeur qui comprend votre métier avant d’écrire une ligne de code.</h2>
      <p class="mt-5 max-w-2xl text-muted">
        Depuis 2021, je conçois des applications web de A à Z : compréhension du besoin, conception, développement,
        mise en production et maintenance. Mon objectif : construire une solution adaptée aujourd’hui et capable
        d’évoluer demain.
      </p>

      <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-4">
        {stats.map((s) => (
          <div>
            <dt class="font-display text-2xl font-semibold text-accent-fg sm:text-[1.7rem]">{s.value}</dt>
            <dd class="mt-2 text-[13px] leading-snug text-muted">{s.label}</dd>
          </div>
        ))}
      </dl>

      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {reasons.map((r) => {
          const Icon = r.icon;
          return (
            <li class="group lift rounded-card border border-line bg-surface p-5">
              <span class="grid size-10 place-items-center rounded-2xl bg-accent-soft text-accent-fg transition duration-300 group-hover:rotate-6 group-hover:scale-110 group-hover:bg-accent group-hover:text-accent-ink"><Icon class="size-5" aria-hidden="true" /></span>
              <h3 class="mt-4 text-base leading-snug font-semibold">{r.title}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-muted">{r.text}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
