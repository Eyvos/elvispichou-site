---
import { Image } from 'astro:assets';
import { MapPin } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { getCases } from '../../lib/cases';
import { useI18n, localePath, langStaticPaths } from '../../i18n';
import { getPhoto } from '../../lib/assets';
import { icons, viewBoxes } from '../../lib/social-icons';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang, t } = useI18n(Astro.url);
const p = t.profile;
const photo = getPhoto();

// Les compétences sont des identifiants : noms propres tels quels, 'unit-tests' et 'geolocation' traduits (`profile.skills`).
const stack = [
  { group: 'frontend', items: ['TypeScript', 'React', 'Next.js', 'Astro', 'Tailwind CSS', 'WordPress', 'SEO'] },
  { group: 'backend', items: ['Node.js', 'NestJS', 'Symfony', 'API REST', 'Socket.IO'] },
  { group: 'data', items: ['PostgreSQL', 'MongoDB', 'Redis'] },
  { group: 'infra', items: ['Docker', 'GitHub Actions', 'GitLab CI', 'Traefik', 'Grafana', 'Linux', 'unit-tests'] },
  { group: 'integrations', items: ['Stripe', 'Keycloak', 'Webhooks', 'geolocation', 'FullCalendar'] },
] as const;
const skillLabel = (id: string) => (p.skills as Record<string, string>)[id] ?? id;

/**
 * `skills` doit reprendre les libellés de `stack` : un clic sur une expérience met ces puces en évidence.
 * Chariot, Trik3r, Gendarmerie : piles des études de cas (bloc « Sous le capot »).
 * Lortal : WordPress existant, SEO. Le SEO est aussi porté par Chariot, Trik3r et Ingrid (D-131).
 */
const experiences = [
  {
    id: 'chariot' as const,
    skills: ['TypeScript', 'React', 'Next.js', 'NestJS', 'Node.js', 'API REST', 'MongoDB', 'PostgreSQL', 'Redis', 'Socket.IO', 'Keycloak', 'Stripe', 'Webhooks', 'Docker', 'Traefik', 'Grafana', 'GitHub Actions', 'SEO', 'unit-tests'],
  },
  {
    id: 'gendarmerie' as const,
    skills: ['React', 'Next.js', 'NestJS', 'Node.js', 'Symfony', 'PostgreSQL', 'Tailwind CSS', 'Docker', 'GitLab CI', 'Linux', 'API REST', 'geolocation', 'FullCalendar', 'unit-tests'],
  },
  {
    id: 'trik3r' as const,
    skills: ['TypeScript', 'React', 'Next.js', 'NestJS', 'Node.js', 'Tailwind CSS', 'API REST', 'MongoDB', 'Stripe', 'Webhooks', 'geolocation', 'Docker', 'SEO', 'unit-tests'],
  },
  {
    id: 'lortal' as const,
    skills: ['WordPress', 'SEO'],
    url: 'https://sophrologue-lortal.fr',
  },
  {
    id: 'ingrid' as const,
    skills: ['React', 'Next.js', 'Tailwind CSS', 'PostgreSQL', 'SEO'],
    url: 'https://ingrid-medium.fr',
  },
].map((e) => ({ url: undefined as string | undefined, ...e, ...p.experienceItems[e.id] }));

const socials = [
  { label: 'Malt', href: site.links.malt },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'GitHub', href: site.links.github },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const cases = await getCases(lang);
const caseIds = new Set(cases.map((c) => c.slug));
---

<BaseLayout title={p.title} description={p.description} pageType="ProfilePage" crumbs={[{ name: p.title, path: '/profil' }]}>
  {/* Alternance des fonds comme sur l'accueil (D-120) : gris (synthèse) → fond de page (expériences et stack) → gris (formation) → fond de page (ce site) → pied de page gris. */}
  {/* 1 · Global */}
  <section class="border-b border-line bg-surface">
    <div class="container-page grid gap-6 py-8 sm:gap-8 sm:py-16 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14 lg:py-20">
      {/* Téléphone et tablette : grande photo calée à gauche, liens Malt / LinkedIn / GitHub en colonne à sa droite (D-119). Bureau : photo à droite, liens centrés dessous. */}
      <div class="flex items-center gap-6 lg:col-start-2 lg:row-start-1 lg:w-fit lg:flex-col lg:gap-5">
        <div class="relative aspect-[4/5] w-36 shrink-0 overflow-hidden rounded-2xl border border-line bg-surface-2 sm:w-44 lg:w-72 lg:rounded-card">
          {photo ? (
            <Image src={photo} alt={p.photoAlt} widths={[288, 576]} sizes="(min-width: 1024px) 288px, 176px" loading="eager" fetchpriority="high" class="size-full object-cover object-[50%_20%]" />
          ) : (
            <div class="grid size-full place-items-center"><span class="font-display text-4xl font-semibold text-accent-fg" aria-hidden="true">EP</span></div>
          )}
        </div>
          <p class="flex flex-col items-start gap-1 text-sm font-semibold lg:flex-row lg:flex-wrap lg:items-center lg:justify-center lg:gap-x-5 lg:gap-y-2">
            {site.links.cv && <a href={site.links.cv} class="underline decoration-line-strong underline-offset-4 hover:decoration-ink" download data-umami-event="cv-download">{p.cv}</a>}
            {socials.map((l) => (
              <a href={l.href} class="inline-flex items-center gap-2 underline decoration-line-strong max-lg:min-h-10 underline-offset-4 hover:decoration-ink" target="_blank" rel="noopener me">
                <svg class="size-4 shrink-0" viewBox={viewBoxes[l.label] ?? '0 0 24 24'} aria-hidden="true" set:html={icons[l.label]} />{l.label}<span class="sr-only">{t.common.newWindow}</span>
              </a>
            ))}
          </p>
      </div>

      <div class="lg:col-start-1 lg:row-start-1">
        <p class="eyebrow">{p.title}</p>
        <h1 class="mt-3 max-w-3xl text-3xl font-medium leading-tight sm:text-4xl">
          {p.h1}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          {p.intro}
        </p>

        <dl class="mt-8 grid max-w-xl grid-cols-3 gap-4">
          {p.stats.map((st) => (
            <div><dt class="text-sm text-muted">{st.label}</dt><dd class="mt-1 font-heading text-xl font-semibold sm:text-2xl">{st.value}</dd></div>
          ))}
        </dl>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <li class="flex items-center gap-1.5 text-muted"><MapPin class="size-4" aria-hidden="true" />{p.remote}</li>
          <li class="text-muted">{p.languages}</li>
        </ul>

        <div class="mt-9">
          <a href={localePath(lang, '/#contact')} class="btn btn-primary" data-umami-event="profil-contact">{p.cta}</a>

        </div>
      </div>
    </div>
  </section>

  {/* 2 · Corps : expériences à gauche (un clic allume leurs compétences dans la stack), stack à droite */}
  <section class="container-page py-12 sm:py-20">
    <div class="grid gap-12 sm:gap-16 lg:grid-cols-[minmax(0,1.9fr)_minmax(0,1fr)] lg:items-start lg:gap-16">
      <div id="experiences">
        <h2 class="text-2xl font-semibold">{p.experiences}</h2>
        <p class="mt-3 max-w-xl text-muted"><span class="lg:hidden">{p.experiencesHintTouch}</span><span class="max-lg:hidden">{p.experiencesHint}</span></p>

        <ol class="xp-line relative mt-8 space-y-6 pl-6 sm:mt-12 sm:space-y-10 lg:grid lg:grid-cols-2 lg:space-y-0 lg:pl-0">
          {experiences.map((e, i) => {
            const host = e.url?.replace('https://', '');
            return (
              <li
                data-xp={e.id}
                data-skills={JSON.stringify(e.skills)}
                class:list={[
                  'relative lg:row-span-2 lg:[grid-row-start:var(--r)] lg:pb-8',
                  i % 2 === 0 ? 'lg:col-start-1 lg:pr-7' : 'lg:col-start-2 lg:pl-7',
                ]}
                style={`--r:${i + 1}`}
              >
                <span class:list={['xp-conn', i % 2 === 0 ? 'xp-side-l' : 'xp-side-r']} aria-hidden="true"></span>
                <span class:list={['xp-dot', i % 2 === 0 ? 'xp-side-l' : 'xp-side-r']} aria-hidden="true"></span>
                <div class="xp-card rounded-card border border-line bg-surface [[data-open]>&]:border-accent [[data-open]>&]:bg-accent-soft">
                  <button type="button" data-xp-toggle aria-pressed="false" class="block w-full rounded-card p-6 text-left">
                    <span class="block text-[13px] font-semibold text-muted">{e.period}</span>
                    <span class="mt-1.5 block font-heading text-lg leading-snug font-semibold">{e.title}</span>
                    <span class="mt-0.5 block font-semibold text-accent-fg">{e.org}</span>
                    <span class="mt-3 block text-sm leading-relaxed text-muted">{e.text}</span>
                  </button>
                  {/* Téléphone et tablette : la stack est loin plus bas, les compétences s'ouvrent dans la carte touchée (D-118). Bureau : elles s'allument dans la stack (D-103). */}
                  {e.skills.length > 0 && (
                    <div class="xp-skills px-6 pb-5">
                      <p class="text-xs font-bold tracking-[0.1em] text-accent-fg uppercase">{p.stack}</p>
                      <ul class="mt-2 flex flex-wrap gap-2">
                        {e.skills.map((i) => <li data-skill={i} class="rounded-md border border-line-strong bg-surface px-2.5 py-1 font-mono text-[13px]">{skillLabel(i)}</li>)}
                      </ul>
                    </div>
                  )}
                  {(caseIds.has(e.id) || e.url) && (
                    <p class="flex flex-wrap gap-x-5 gap-y-1 px-6 pb-6 text-sm font-medium">
                      {caseIds.has(e.id) && <a href={localePath(lang, `/realisations/${e.id}`)} class="text-accent-fg max-lg:inline-flex max-lg:min-h-10 max-lg:items-center pointer-coarse:inline-flex pointer-coarse:min-h-10 pointer-coarse:items-center">{p.caseLink}</a>}
                      {e.url && <a href={e.url} class="font-mono text-[13px] text-accent-fg max-lg:inline-flex max-lg:min-h-10 max-lg:items-center pointer-coarse:inline-flex pointer-coarse:min-h-10 pointer-coarse:items-center" target="_blank" rel="noopener">{host}<span class="sr-only">{t.common.newWindow}</span></a>}
                    </p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </div>

      <div id="stack">
        <h2 class="text-2xl font-semibold">{p.stack}</h2>
        <div class="mt-8 space-y-7">
          {stack.map((s) => (
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.1em] text-muted">{p.stackGroups[s.group]}</p>
              <ul class="mt-3 flex flex-wrap gap-2.5">
                {s.items.map((i) => <li data-skill={i} class="skill rounded-md border border-line-strong bg-surface px-2.5 py-1 font-mono text-[13px] transition-colors">{skillLabel(i)}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* 3 · Formation, à l'horizontale sous les deux colonnes */}
  <section id="formation" class="border-t border-line bg-surface">
    <div class="container-page py-10 sm:py-16">
      <h2 class="text-2xl font-semibold">{p.education}</h2>
      <ul class="mt-8 grid gap-y-6 md:grid-cols-3">
        {p.educationItems.map((e) => (
          <li class="border-l-2 border-line-strong pl-5 md:pl-8 md:first:border-l-0 md:first:pl-0">
            <p class="text-[13px] font-semibold text-muted">{e.years}</p>
            <p class="mt-1.5 font-heading text-lg leading-snug font-semibold">{e.title}</p>
            <p class="mt-0.5 font-semibold text-accent-fg">{e.school}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="ce-site" class="border-t border-line">
    <div class="container-page py-10 sm:py-16">
      <p class="eyebrow">{p.thisSite.eyebrow}</p>
      <h2 class="section-title max-w-3xl">{p.thisSite.title}</h2>
      <div class="mt-8 grid gap-8 text-sm leading-relaxed text-muted md:grid-cols-3">
        {p.thisSite.points.map((pt) => (
          <p><strong class="text-ink">{pt.lead}</strong> {pt.text}</p>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  .xp-skills { display: none; }
  @media (max-width: 1023.98px) {
    [data-xp][data-open] .xp-skills { display: block; animation: xp-skills-in 0.25s ease-out; }
  }
  @keyframes xp-skills-in { from { opacity: 0; transform: translateY(-4px); } }
  /* Bureau seulement : sur téléphone et tablette, les compétences s'ouvrent dans la carte touchée et la stack ne se colore plus (D-119). */
  @media (min-width: 1024px) {
  .skill[data-on] {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
    font-weight: 700;
  }
  }
  /* Cartes d'expérience : elles se soulèvent et s'éclairent au survol pour montrer qu'elles sont cliquables. */
  .xp-card { transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s, border-color 0.25s, background-color 0.25s; }
  @media (hover: hover) {
    .xp-card:hover { transform: translateY(-5px); border-color: var(--c-accent); box-shadow: 0 20px 36px -22px var(--c-accent); }
  }

  /* Frise : une ligne de 2 px centrée sur l'axe, des anneaux de 14 px centrés dessus, un trait de liaison vers chaque carte.
     Mobile : axe à gauche. Bureau : axe au milieu, cartes en quinconce. Tous les centres tombent sur l'axe (à 0 px près). */
  .xp-line::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 2px; translate: -50% 0; background: var(--c-line); }
  .xp-dot, .xp-conn { position: absolute; top: 2.125rem; }
  .xp-dot {
    left: -1.5rem; z-index: 1; box-sizing: border-box; width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid var(--c-accent-fg); background: var(--c-bg); translate: -50% -50%;
    transition: scale 0.3s, background-color 0.3s, border-color 0.3s;
  }
  .xp-conn { left: -1.5rem; width: 1.5rem; height: 2px; translate: 0 -50%; background: var(--c-line); }
  .xp-conn::after { content: ''; position: absolute; inset: 0; background: var(--c-accent-fg); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease-out; }
  @media (hover: hover) {
    [data-xp]:hover .xp-dot { scale: 1.2; }
    [data-xp]:hover .xp-conn::after { transform: scaleX(1); }
  }
  [data-xp][data-open] .xp-dot { scale: 1.2; background: var(--c-accent-fg); animation: xp-pulse 1.8s ease-out infinite; }
  [data-xp][data-open] .xp-conn::after { transform: scaleX(1); }
  @keyframes xp-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-accent-fg) 55%, transparent); }
    100% { box-shadow: 0 0 0 10px transparent; }
  }
  @media (min-width: 1024px) {
    .xp-line::before { left: 50%; }
    .xp-conn { width: 1.75rem; }
    .xp-side-l.xp-dot { left: 100%; }
    .xp-side-r.xp-dot { left: 0; }
    .xp-side-l.xp-conn { left: auto; right: 0; }
    .xp-side-r.xp-conn { left: 0; }
    .xp-side-l.xp-conn::after { transform-origin: right; }
  }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-xp]')];
  const skills = [...document.querySelectorAll<HTMLElement>('.skill')];
  const data: Record<string, string[]> = {};
  items.forEach((li) => {
    data[li.dataset.xp!] = JSON.parse(li.dataset.skills ?? '[]') as string[];
  });

  function select(id: string | null) {
    items.forEach((li) => {
      const on = li.dataset.xp === id;
      li.toggleAttribute('data-open', on);
      li.querySelector('[data-xp-toggle]')!.setAttribute('aria-pressed', String(on));
    });
    const set = new Set(id ? data[id] : []);
    skills.forEach((s) => s.toggleAttribute('data-on', set.has(s.dataset.skill!)));
  }

  items.forEach((li) =>
    li.querySelector('[data-xp-toggle]')!.addEventListener('click', () => select(li.hasAttribute('data-open') ? null : li.dataset.xp!)),
  );
</script>
