# Formulaire de contact (https://resend.com) — en local, copier ces trois lignes dans .dev.vars ; sans clé, les demandes s'affichent dans la console.
RESEND_API_KEY=
CONTACT_FROM="Elvis Pichou <contact@elvispichou.com>"
CONTACT_TO=

# Analytics Umami (https://umami.is) — sans ID, aucun script n'est chargé.
PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://analytics.elvispichou.com/script.js  # si auto-hébergé
